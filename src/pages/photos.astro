---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width"
  />

  <link
    rel="preconnect"
    href="https://rsms.me"
  />

  <link
    rel="stylesheet"
    href="https://rsms.me/inter/inter.css"
  />

  <script is:inline>
    (() => {

      const savedTheme =
        localStorage.getItem("theme");

      const theme =
        savedTheme ||
        (
          window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches
            ? "dark"
            : "light"
        );

      document.documentElement.dataset.theme =
        theme;

    })();
  </script>

  <title>Photos — Abhijith</title>

  <meta
    name="description"
    content="Photography by Abhijith."
  />


  <style>
    .site-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
      color: inherit;
      text-decoration: none;
      line-height: 1;
    }


    .site-brand:hover {
      color: inherit;
      text-decoration: none;
    }


    .site-title {
      color: inherit;
      text-decoration: none;
    }


    .profile-pic {
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      padding: 2px;
      display: block;
      background: linear-gradient(
        135deg,
        #00e5ff 0%,
        #009cff 30%,
        #0066ff 58%,
        #3155ff 80%,
        #635bff 100%
      );
      border-radius: 50%;
    }


    .profile-pic img {
      display: block;
      width: 32px;
      height: 32px;
      margin: 0;
      padding: 0;
      object-fit: cover;
      border: 0;
      border-radius: 50%;
    }


    /* ==================================================
       Photos page
    ================================================== */

    .photos-page {
      width: 100%;
    }


    .photos-page-header {
      margin: 0 0 38px;
    }


    .photos-page-header h1 {
      margin: 0 0 12px;

      color: var(--text);

      font-size: 21px;
      line-height: 1.45;
      font-weight: 400;

      letter-spacing: -0.015em;
    }


    .photos-page-header p {
      margin: 0;

      color: var(--muted);

      font-size: 16px;
      line-height: 1.65;
    }


    /* ==================================================
       Photo grid
    ================================================== */

    .photo-grid {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 12px;
    }


    .photo {
      display: block;

      width: 100%;
      aspect-ratio: 3 / 4;

      margin: 0;
      padding: 0;

      overflow: hidden;

      background: var(--border);

      border: 0;
      border-radius: 0;

      cursor: zoom-in;

      appearance: none;
      -webkit-appearance: none;
    }


    .photo img {
      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        opacity 0.2s ease,
        transform 0.35s ease;
    }


    .photo:hover img {
      opacity: 0.92;
    }


    /* ==================================================
       Fullscreen photo viewer
    ================================================== */

    /*
      The viewer is always dark.

      The layout has two separate areas:

      LEFT  = photograph
      RIGHT = optional metadata

      This means metadata can never overlap
      the photograph.
    */

    .photo-viewer {
      position: fixed;

      inset: 0;

      z-index: 1000;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        235px;

      align-items: center;

      column-gap: 54px;

      padding: 48px 72px 48px 96px;

      background: #080808;

      opacity: 0;
      visibility: hidden;

      pointer-events: none;

      transition:
        opacity 0.2s ease,
        visibility 0.2s ease;
    }


    .photo-viewer.is-open {
      opacity: 1;
      visibility: visible;

      pointer-events: auto;
    }


    /* ==================================================
       Viewer image
    ================================================== */

    .photo-viewer-image {
      display: block;

      justify-self: center;

      width: auto;
      height: auto;

      max-width: 100%;
      max-height: 88vh;

      object-fit: contain;

      user-select: none;

      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.35);
    }


    /* ==================================================
       Metadata
    ================================================== */

    .photo-viewer-meta {
      position: static;

      width: 100%;

      color: rgba(255, 255, 255, 0.55);

      font-size: 13px;
      line-height: 1.55;
    }


    .photo-viewer-meta.is-empty {
      display: none;
    }


    .photo-viewer-meta-caption {
      display: none;

      margin: 0 0 12px;

      color: rgba(255, 255, 255, 0.95);

      font-size: 17px;
      line-height: 1.45;
      font-weight: 400;

      letter-spacing: -0.01em;
    }


    .photo-viewer-meta-location {
      display: none;

      margin: 0 0 8px;

      color: rgba(255, 255, 255, 0.72);

      font-size: 13px;
      line-height: 1.5;
    }


    .photo-viewer-meta-details {
      display: none;

      margin: 0;

      color: rgba(255, 255, 255, 0.45);

      font-size: 12px;
      line-height: 1.6;
    }


    .photo-viewer-meta.has-caption
    .photo-viewer-meta-caption {
      display: block;
    }


    .photo-viewer-meta.has-location
    .photo-viewer-meta-location {
      display: block;
    }


    .photo-viewer-meta.has-details
    .photo-viewer-meta-details {
      display: block;
    }


    /* ==================================================
       Viewer controls
    ================================================== */

    .photo-viewer-close,
    .photo-viewer-prev,
    .photo-viewer-next {
      position: absolute;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 40px;
      height: 40px;

      padding: 0;

      color: rgba(255, 255, 255, 0.78);

      background: transparent;

      border: 0;
      border-radius: 50%;

      cursor: pointer;

      transition:
        color 0.15s ease,
        background 0.15s ease;
    }


    .photo-viewer-close:hover,
    .photo-viewer-prev:hover,
    .photo-viewer-next:hover {
      color: #ffffff;

      background: rgba(255, 255, 255, 0.09);
    }


    .photo-viewer-close {
      top: 20px;
      right: 20px;
    }


    .photo-viewer-prev {
      top: 50%;
      left: 18px;

      transform: translateY(-50%);
    }


    .photo-viewer-next {
      top: 50%;
      right: 18px;

      transform: translateY(-50%);
    }


    .photo-viewer svg {
      width: 20px;
      height: 20px;

      fill: none;
      stroke: currentColor;

      stroke-width: 1.4;

      stroke-linecap: round;
      stroke-linejoin: round;
    }


    /* ==================================================
       Counter
    ================================================== */

    .photo-viewer-counter {
      position: absolute;

      left: 50%;
      bottom: 18px;

      transform: translateX(-50%);

      color: rgba(255, 255, 255, 0.5);

      font-size: 12px;
      line-height: 1.4;

      font-variant-numeric: tabular-nums;
    }


    /* ==================================================
       Mobile
    ================================================== */

    @media (max-width: 600px) {

      .site-header {
        gap: 8px;
      }


      .site-brand {
        gap: 6px;
      }


      .profile-pic {
        width: 26px;
        height: 26px;
        flex: 0 0 26px;
        padding: 2px;
      }


      .profile-pic img {
        width: 22px;
        height: 22px;
      }


      .site-title {
        font-size: 17px;
      }


      .header-right {
        gap: 6px;
        min-width: 0;
      }


      nav {
        gap: 8px;
      }


      nav a {
        font-size: 13px;
      }


      .theme-toggle {
        width: 18px;
        height: 18px;
        flex: 0 0 18px;
      }


      .theme-toggle svg {
        width: 15px;
        height: 15px;
      }


      .photos-page-header {
        margin-bottom: 30px;
      }


      .photo-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));

        gap: 7px;
      }


      /*
        On mobile the metadata moves below
        the photograph.
      */

      .photo-viewer {
        display: flex;

        flex-direction: column;

        justify-content: center;

        padding: 30px 42px 100px;

        gap: 18px;
      }


      .photo-viewer-image {
        width: auto;
        height: auto;

        max-width: 88vw;
        max-height: 72vh;
      }


      .photo-viewer-meta {
        width: 100%;

        text-align: center;
      }


      .photo-viewer-meta-caption {
        margin-bottom: 6px;

        font-size: 14px;
        line-height: 1.45;
      }


      .photo-viewer-meta-location {
        margin-bottom: 4px;

        font-size: 12px;
      }


      .photo-viewer-meta-details {
        font-size: 11px;
      }


      .photo-viewer-close {
        top: 10px;
        right: 10px;
      }


      .photo-viewer-prev {
        left: 4px;
      }


      .photo-viewer-next {
        right: 4px;
      }


      .photo-viewer-counter {
        bottom: 12px;
      }

    }

  </style>

</head>


<body>

  <main class="container">


    <!-- ==================================================
         Header
    ================================================== -->

    <header class="site-header">

      <a href="/" class="site-brand">
        <span class="profile-pic">
          <img src="/profile.png" alt="Abhijith" />
        </span>
        <span class="site-title">
          Abhijith
        </span>
      </a>


      <div class="header-right">

        <nav>

          <a href="/">
            home
          </a>

          <a href="/blog">
            blog
          </a>

          <a
            href="/photos"
            class="active"
          >
            photos
          </a>

          <a href="/now">
            now
          </a>

        </nav>


        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch to dark mode"
          title="Switch to dark mode"
        >

          <svg
            class="theme-icon-moon"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >

            <path
              d="M21 12.8A8.5 8.5 0 0 1 11.2 3a8.5 8.5 0 1 0 9.8 9.8Z"
            />

          </svg>


          <svg
            class="theme-icon-sun"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >

            <circle
              cx="12"
              cy="12"
              r="4"
            />

            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="M4.93 4.93l1.41 1.41" />
            <path d="M17.66 17.66l1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="M6.34 17.66l-1.41 1.41" />
            <path d="M19.07 4.93l-1.41-1.41" />

          </svg>


          <span class="sr-only">
            Toggle colour theme
          </span>

        </button>

      </div>

    </header>


    <!-- ==================================================
         Photos
    ================================================== -->

    <section class="photos-page">


      <header class="photos-page-header">

        <h1>
          Photos
        </h1>

        <p>
          A small collection of things I've seen and photographed.
        </p>

      </header>


      <div class="photo-grid">

        {
          photos.map((photo, index) => (

            <button
              class="photo"
              type="button"
              data-photo-index={index}
              aria-label={`Open photo ${index + 1}`}
            >

              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
              />

            </button>

          ))
        }

      </div>


    </section>


    <footer>

      <a href="/">
        ← Home
      </a>

    </footer>


  </main>


  <!-- ==================================================
       Fullscreen viewer
  ================================================== -->

  <div
    class="photo-viewer"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
  >


    <button
      class="photo-viewer-close"
      type="button"
      aria-label="Close photo viewer"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="M5 5l14 14" />
        <path d="M19 5L5 19" />

      </svg>

    </button>


    <button
      class="photo-viewer-prev"
      type="button"
      aria-label="Previous photo"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="m15 18-6-6 6-6" />

      </svg>

    </button>


    <img
      class="photo-viewer-image"
      src=""
      alt=""
    />


    <div class="photo-viewer-meta">

      <div class="photo-viewer-meta-caption"></div>

      <div class="photo-viewer-meta-location"></div>

      <div class="photo-viewer-meta-details"></div>

    </div>


    <button
      class="photo-viewer-next"
      type="button"
      aria-label="Next photo"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="m9 18 6-6-6-6" />

      </svg>

    </button>


    <div class="photo-viewer-counter">

      <span class="photo-viewer-current">
        1
      </span>

      /

      <span class="photo-viewer-total">
        {photos.length}
      </span>

    </div>


  </div>


  <script is:inline>

    /* ==================================================
       Theme switcher
    ================================================== */

    const themeButton =
      document.querySelector(".theme-toggle");


    function updateThemeButton() {

      const isDark =
        document.documentElement.dataset.theme === "dark";


      themeButton.setAttribute(
        "aria-label",
        isDark
          ? "Switch to light mode"
          : "Switch to dark mode"
      );


      themeButton.setAttribute(
        "title",
        isDark
          ? "Switch to light mode"
          : "Switch to dark mode"
      );

    }


    themeButton.addEventListener(
      "click",
      () => {

        const isDark =
          document.documentElement.dataset.theme === "dark";


        const newTheme =
          isDark
            ? "light"
            : "dark";


        document.documentElement.dataset.theme =
          newTheme;


        localStorage.setItem(
          "theme",
          newTheme
        );


        updateThemeButton();

      }
    );


    updateThemeButton();


    /* ==================================================
       Photo viewer
    ================================================== */

    const photoButtons =
      Array.from(
        document.querySelectorAll(".photo")
      );


    const viewer =
      document.querySelector(".photo-viewer");


    const viewerImage =
      document.querySelector(
        ".photo-viewer-image"
      );


    const viewerMeta =
      document.querySelector(
        ".photo-viewer-meta"
      );


    const viewerCaption =
      document.querySelector(
        ".photo-viewer-meta-caption"
      );


    const viewerLocation =
      document.querySelector(
        ".photo-viewer-meta-location"
      );


    const viewerDetails =
      document.querySelector(
        ".photo-viewer-meta-details"
      );


    const closeButton =
      document.querySelector(
        ".photo-viewer-close"
      );


    const previousButton =
      document.querySelector(
        ".photo-viewer-prev"
      );


    const nextButton =
      document.querySelector(
        ".photo-viewer-next"
      );


    const currentCounter =
      document.querySelector(
        ".photo-viewer-current"
      );


    let currentIndex = 0;


    /* ==================================================
       Optional metadata

       All fields are optional.

       Leave them as "" if you don't want
       that information displayed.
    ================================================== */

    const metadata = [
      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "Morning mist over the tea plantations",
        location: "Munnar, Kerala",
        date: "January 2026",
        camera: "Sony A7 III",
        lens: "35mm f/1.8",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },

      {
        caption: "",
        location: "",
        date: "",
        camera: "",
        lens: "",
      },
    ];


    function updateMetadata(index) {

      const data =
        metadata[index];


      viewerMeta.classList.remove(
        "is-empty",
        "has-caption",
        "has-location",
        "has-details"
      );


      viewerCaption.textContent = "";
      viewerLocation.textContent = "";
      viewerDetails.textContent = "";


      if (!data) {

        viewerMeta.classList.add(
          "is-empty"
        );

        return;

      }


      const details = [
        data.date,
        data.camera,
        data.lens,
      ].filter(Boolean);


      if (data.caption) {

        viewerCaption.textContent =
          data.caption;

        viewerMeta.classList.add(
          "has-caption"
        );

      }


      if (data.location) {

        viewerLocation.textContent =
          data.location;

        viewerMeta.classList.add(
          "has-location"
        );

      }


      if (details.length > 0) {

        viewerDetails.textContent =
          details.join(" · ");

        viewerMeta.classList.add(
          "has-details"
        );

      }


      if (
        !data.caption &&
        !data.location &&
        details.length === 0
      ) {

        viewerMeta.classList.add(
          "is-empty"
        );

      }

    }


    function showPhoto(index) {

      if (index < 0) {

        index =
          photoButtons.length - 1;

      }


      if (
        index >= photoButtons.length
      ) {

        index = 0;

      }


      currentIndex = index;


      const button =
        photoButtons[currentIndex];


      const image =
        button.querySelector("img");


      viewerImage.src =
        image.src;


      viewerImage.alt =
        image.alt;


      currentCounter.textContent =
        String(currentIndex + 1);


      updateMetadata(
        currentIndex
      );


      viewer.classList.add(
        "is-open"
      );


      document.body.classList.add(
        "viewer-open"
      );


      closeButton.focus();

    }


    function closeViewer() {

      viewer.classList.remove(
        "is-open"
      );


      document.body.classList.remove(
        "viewer-open"
      );


      viewerImage.src = "";
      viewerImage.alt = "";

    }


    function showPrevious() {

      showPhoto(
        currentIndex - 1
      );

    }


    function showNext() {

      showPhoto(
        currentIndex + 1
      );

    }


    /* ==================================================
       Open photos
    ================================================== */

    photoButtons.forEach(
      (button, index) => {

        button.addEventListener(
          "click",
          () => {

            showPhoto(index);

          }
        );

      }
    );


    /* ==================================================
       Viewer controls
    ================================================== */

    closeButton.addEventListener(
      "click",
      closeViewer
    );


    previousButton.addEventListener(
      "click",
      showPrevious
    );


    nextButton.addEventListener(
      "click",
      showNext
    );


    viewer.addEventListener(
      "click",
      (event) => {

        if (
          event.target === viewer
        ) {

          closeViewer();

        }

      }
    );


    /* ==================================================
       Keyboard navigation
    ================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          !viewer.classList.contains(
            "is-open"
          )
        ) {

          return;

        }


        if (
          event.key === "Escape"
        ) {

          closeViewer();

        }


        if (
          event.key === "ArrowLeft"
        ) {

          showPrevious();

        }


        if (
          event.key === "ArrowRight"
        ) {

          showNext();

        }

      }
    );

  </script>

</body>

</html>