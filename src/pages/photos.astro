---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeInit from "../components/ThemeInit.astro";

const photoModules = import.meta.glob(
  "../assets/photos/*.{jpg,jpeg,png,webp,avif}",
  {
    eager: true,
    query: "?url",
    import: "default",
  }
);

const photos = Object.entries(photoModules)
  .map(([path, src]) => ({
    src: src as string,
    filename: path.split("/").pop() ?? "",
    alt: "Photography by Abhijith",
  }))
  .sort((a, b) =>
    a.filename.localeCompare(
      b.filename,
      undefined,
      { numeric: true }
    )
  );

const metadata: Record<
  string,
  {
    caption?: string;
    location?: string;
    date?: string;
    camera?: string;
    lens?: string;
  }
> = {
  /*
    Add optional metadata here using the exact filename.

    Example:

    "03.jpg": {
      caption: "Morning mist over the tea plantations",
      location: "Munnar, Kerala",
      date: "January 2026",
      camera: "Sony A7 III",
      lens: "35mm f/1.8",
    },
  */

  "03.jpg": {
    caption: "Morning mist over the tea plantations",
    location: "Munnar, Kerala",
    date: "January 2026",
    camera: "Sony A7 III",
    lens: "35mm f/1.8",
  },
};
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width"
  />

  <link
    rel="preconnect"
    href="https://rsms.me"
  />

  <link
    rel="stylesheet"
    href="https://rsms.me/inter/inter.css"
  />
    <ThemeInit />
<title>Photos — Abhijith</title>

  <meta
    name="description"
    content="Photography by Abhijith."
  />

  <style>

    /* ==================================================
       Photos page/* ==================================================
       Photos page
    ================================================== */

    .photos-page {
      width: 100%;
    }


    .photos-page-header {
      margin: 0 0 38px;
    }


    .photos-page-header h1 {
      margin: 0 0 12px;

      color: var(--text);

      font-size: 21px;
      line-height: 1.45;
      font-weight: 400;

      letter-spacing: -0.015em;
    }


    .photos-page-header p {
      margin: 0;

      color: var(--muted);

      font-size: 16px;
      line-height: 1.65;
    }


    /* ==================================================
       Photo grid
    ================================================== */

    .photo-grid {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 12px;
    }


    .photo {
      display: block;

      width: 100%;

      aspect-ratio: 3 / 4;

      margin: 0;
      padding: 0;

      overflow: hidden;

      background: var(--border);

      border: 0;
      border-radius: 0;

      cursor: zoom-in;

      appearance: none;
      -webkit-appearance: none;
    }


    .photo img {
      display: block;

      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        opacity 0.2s ease,
        transform 0.35s ease;
    }


    .photo:hover img {
      opacity: 0.92;
    }


    /* ==================================================
       Fullscreen photo viewer
    ================================================== */

    .photo-viewer {
      position: fixed;

      inset: 0;

      z-index: 1000;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        235px;

      align-items: center;

      column-gap: 54px;

      padding: 48px 72px 48px 96px;

      background: #080808;

      opacity: 0;
      visibility: hidden;

      pointer-events: none;

      transition:
        opacity 0.2s ease,
        visibility 0.2s ease;
    }


    .photo-viewer.is-open {
      opacity: 1;
      visibility: visible;

      pointer-events: auto;
    }


    /* ==================================================
       Viewer image
    ================================================== */

    .photo-viewer-image {
      display: block;

      justify-self: center;

      width: auto;
      height: auto;

      max-width: 100%;
      max-height: 88vh;

      object-fit: contain;

      user-select: none;

      box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.35);
    }


    /* ==================================================
       Metadata
    ================================================== */

    .photo-viewer-meta {
      position: static;

      width: 100%;

      color: rgba(255, 255, 255, 0.55);

      font-size: 13px;
      line-height: 1.55;
    }


    .photo-viewer-meta.is-empty {
      display: none;
    }


    .photo-viewer-meta-caption {
      display: none;

      margin: 0 0 12px;

      color: rgba(255, 255, 255, 0.95);

      font-size: 17px;
      line-height: 1.45;
      font-weight: 400;

      letter-spacing: -0.01em;
    }


    .photo-viewer-meta-location {
      display: none;

      margin: 0 0 8px;

      color: rgba(255, 255, 255, 0.72);

      font-size: 13px;
      line-height: 1.5;
    }


    .photo-viewer-meta-details {
      display: none;

      margin: 0;

      color: rgba(255, 255, 255, 0.45);

      font-size: 12px;
      line-height: 1.6;
    }


    .photo-viewer-meta.has-caption
    .photo-viewer-meta-caption {
      display: block;
    }


    .photo-viewer-meta.has-location
    .photo-viewer-meta-location {
      display: block;
    }


    .photo-viewer-meta.has-details
    .photo-viewer-meta-details {
      display: block;
    }


    /* ==================================================
       Viewer controls
    ================================================== */

    .photo-viewer-close,
    .photo-viewer-prev,
    .photo-viewer-next {
      position: absolute;

      display: flex;

      align-items: center;
      justify-content: center;

      width: 40px;
      height: 40px;

      padding: 0;

      color: rgba(255, 255, 255, 0.78);

      background: transparent;

      border: 0;
      border-radius: 50%;

      cursor: pointer;

      transition:
        color 0.15s ease,
        background 0.15s ease;
    }


    .photo-viewer-close:hover,
    .photo-viewer-prev:hover,
    .photo-viewer-next:hover {
      color: #ffffff;

      background: rgba(255, 255, 255, 0.09);
    }


    .photo-viewer-close {
      top: 20px;
      right: 20px;
    }


    .photo-viewer-prev {
      top: 50%;
      left: 18px;

      transform: translateY(-50%);
    }


    .photo-viewer-next {
      top: 50%;
      right: 18px;

      transform: translateY(-50%);
    }


    .photo-viewer svg {
      width: 20px;
      height: 20px;

      fill: none;

      stroke: currentColor;

      stroke-width: 1.4;

      stroke-linecap: round;
      stroke-linejoin: round;
    }


    /* ==================================================
       Counter
    ================================================== */

    .photo-viewer-counter {
      position: absolute;

      left: 50%;
      bottom: 18px;

      transform: translateX(-50%);

      color: rgba(255, 255, 255, 0.5);

      font-size: 12px;
      line-height: 1.4;

      font-variant-numeric: tabular-nums;
    }


    /* ==================================================
       Mobile
    ================================================== */

    body.viewer-open {
      overflow: hidden;
      overscroll-behavior: none;
    }

    @media (max-width: 700px) {

      .photo-viewer {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, 1fr) auto;
        align-items: center;
        justify-items: center;
        column-gap: 0;
        row-gap: 0;
        padding: max(64px, env(safe-area-inset-top) + 52px)
                 52px
                 max(64px, env(safe-area-inset-bottom) + 44px);
        min-height: 100dvh;
        min-height: 100svh;
      }

      .photo-viewer-image {
        grid-column: 1;
        grid-row: 1;
        width: auto;
        height: auto;
        max-width: calc(100vw - 72px);
        max-height: min(72dvh, calc(100dvh - 180px));
        max-height: min(72svh, calc(100svh - 180px));
        object-fit: contain;
        touch-action: pan-y;
      }

      .photo-viewer-meta {
        grid-column: 1;
        grid-row: 2;
        width: min(100%, 420px);
        min-width: 0;
        margin-top: 18px;
        padding: 0 2px;
        text-align: left;
      }

      .photo-viewer-meta-caption {
        margin-bottom: 8px;
        font-size: 15px;
        line-height: 1.45;
      }

      .photo-viewer-meta-location {
        margin-bottom: 6px;
        font-size: 12px;
      }

      .photo-viewer-meta-details {
        font-size: 11px;
        line-height: 1.5;
      }

      .photo-viewer-close,
      .photo-viewer-prev,
      .photo-viewer-next {
        width: 44px;
        height: 44px;
      }

      .photo-viewer-close {
        top: max(12px, env(safe-area-inset-top));
        right: max(12px, env(safe-area-inset-right));
      }

      .photo-viewer-prev {
        left: max(8px, env(safe-area-inset-left));
        top: 50%;
      }

      .photo-viewer-next {
        right: max(8px, env(safe-area-inset-right));
        top: 50%;
      }

      .photo-viewer-counter {
        bottom: max(14px, env(safe-area-inset-bottom) + 8px);
        font-size: 11px;
      }

    }

    @media (max-width: 380px) {

      .photo-viewer {
        padding-left: 46px;
        padding-right: 46px;
        padding-top: max(58px, env(safe-area-inset-top) + 46px);
        padding-bottom: max(58px, env(safe-area-inset-bottom) + 40px);
      }

      .photo-viewer-image {
        max-width: calc(100vw - 62px);
        max-height: min(68dvh, calc(100dvh - 160px));
        max-height: min(68svh, calc(100svh - 160px));
      }

      .photo-viewer-meta {
        margin-top: 12px;
      }

      .photo-viewer-meta-caption {
        font-size: 14px;
      }

    }

    @media (prefers-reduced-motion: reduce) {
      .photo-viewer {
        transition: none;
      }

      .photo img {
        transition: none;
      }
    }
</style>

</head>


<body>

  <main class="container">

    <!-- ==================================================
         Header
    ================================================== -->

    <SiteHeader active="photos" />


    <!-- ==================================================
         Photos
    ================================================== -->

    <section class="photos-page">

      <header class="photos-page-header">

        <h1>
          Photos
        </h1>

        <p>
          A small collection of things I've seen and photographed.
        </p>

      </header>


      <div class="photo-grid">

        {
          photos.map((photo, index) => (

            <button
              class="photo"
              type="button"
              data-photo-index={index}
              data-photo-filename={photo.filename}
              aria-label={`Open photo ${index + 1}`}
            >

              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
              />

            </button>

          ))
        }

      </div>

    </section>


    <footer>

      <a href="/">
        ← Home
      </a>

    </footer>


  </main>


  <!-- ==================================================
       Fullscreen viewer
  ================================================== -->

  <div
    class="photo-viewer"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
  >

    <button
      class="photo-viewer-close"
      type="button"
      aria-label="Close photo viewer"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="M5 5l14 14" />
        <path d="M19 5L5 19" />

      </svg>

    </button>


    <button
      class="photo-viewer-prev"
      type="button"
      aria-label="Previous photo"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="m15 18-6-6 6-6" />

      </svg>

    </button>


    <img
      class="photo-viewer-image"
      src=""
      alt=""
    />


    <div class="photo-viewer-meta">

      <div class="photo-viewer-meta-caption"></div>

      <div class="photo-viewer-meta-location"></div>

      <div class="photo-viewer-meta-details"></div>

    </div>


    <button
      class="photo-viewer-next"
      type="button"
      aria-label="Next photo"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="m9 18 6-6-6-6" />

      </svg>

    </button>


    <div class="photo-viewer-counter">

      <span class="photo-viewer-current">
        1
      </span>

      /

      <span class="photo-viewer-total">
        {photos.length}
      </span>

    </div>

  </div>


  <!-- Make server-side metadata available to browser JavaScript -->

  <script
    type="application/json"
    id="photo-metadata"
    set:html={JSON.stringify(metadata)}
  ></script>


  <script is:inline>
    /* ==================================================
       Photo viewer
    ================================================== */

    const photoButtons =
      Array.from(
        document.querySelectorAll(".photo")
      );


    const viewer =
      document.querySelector(".photo-viewer");


    const viewerImage =
      document.querySelector(
        ".photo-viewer-image"
      );


    const viewerMeta =
      document.querySelector(
        ".photo-viewer-meta"
      );


    const viewerCaption =
      document.querySelector(
        ".photo-viewer-meta-caption"
      );


    const viewerLocation =
      document.querySelector(
        ".photo-viewer-meta-location"
      );


    const viewerDetails =
      document.querySelector(
        ".photo-viewer-meta-details"
      );


    const closeButton =
      document.querySelector(
        ".photo-viewer-close"
      );


    const previousButton =
      document.querySelector(
        ".photo-viewer-prev"
      );


    const nextButton =
      document.querySelector(
        ".photo-viewer-next"
      );


    const currentCounter =
      document.querySelector(
        ".photo-viewer-current"
      );


    const metadataElement =
      document.getElementById(
        "photo-metadata"
      );


    const metadata =
      metadataElement
        ? JSON.parse(
            metadataElement.textContent || "{}"
          )
        : {};


    let currentIndex = 0;


    /* ==================================================
       Optional metadata

       Metadata is matched using the image filename.

       Adding a new photo does NOT require adding
       anything here unless you want metadata.
    ================================================== */

    function updateMetadata(filename) {

      const data =
        metadata[filename];


      viewerMeta.classList.remove(
        "is-empty",
        "has-caption",
        "has-location",
        "has-details"
      );


      viewerCaption.textContent = "";

      viewerLocation.textContent = "";

      viewerDetails.textContent = "";


      if (!data) {

        viewerMeta.classList.add(
          "is-empty"
        );

        return;

      }


      const details = [
        data.date,
        data.camera,
        data.lens,
      ].filter(Boolean);


      if (data.caption) {

        viewerCaption.textContent =
          data.caption;

        viewerMeta.classList.add(
          "has-caption"
        );

      }


      if (data.location) {

        viewerLocation.textContent =
          data.location;

        viewerMeta.classList.add(
          "has-location"
        );

      }


      if (details.length > 0) {

        viewerDetails.textContent =
          details.join(" · ");

        viewerMeta.classList.add(
          "has-details"
        );

      }


      if (
        !data.caption &&
        !data.location &&
        details.length === 0
      ) {

        viewerMeta.classList.add(
          "is-empty"
        );

      }

    }


    function showPhoto(index) {

      if (index < 0) {

        index =
          photoButtons.length - 1;

      }


      if (
        index >= photoButtons.length
      ) {

        index = 0;

      }


      currentIndex = index;


      const button =
        photoButtons[currentIndex];


      const image =
        button.querySelector("img");


      const filename =
        button.dataset.photoFilename || "";


      viewerImage.src =
        image.src;


      viewerImage.alt =
        image.alt;


      currentCounter.textContent =
        String(currentIndex + 1);


      updateMetadata(
        filename
      );


      viewer.classList.add(
        "is-open"
      );


      document.body.classList.add(
        "viewer-open"
      );


      closeButton.focus();

    }


    function closeViewer() {

      viewer.classList.remove(
        "is-open"
      );


      document.body.classList.remove(
        "viewer-open"
      );


      viewerImage.src = "";

      viewerImage.alt = "";

    }


    function showPrevious() {

      showPhoto(
        currentIndex - 1
      );

    }


    function showNext() {

      showPhoto(
        currentIndex + 1
      );

    }


    /* ==================================================
       Open photos
    ================================================== */

    photoButtons.forEach(
      (button, index) => {

        button.addEventListener(
          "click",
          () => {

            showPhoto(index);

          }
        );

      }
    );


    /* ==================================================
       Viewer controls
    ================================================== */

    closeButton.addEventListener(
      "click",
      closeViewer
    );


    previousButton.addEventListener(
      "click",
      showPrevious
    );


    nextButton.addEventListener(
      "click",
      showNext
    );


    viewer.addEventListener(
      "click",
      (event) => {

        if (
          event.target === viewer
        ) {

          closeViewer();

        }

      }
    );


    /* ==================================================
       Touch swipe navigation
    ================================================== */

    let touchStartX = 0;
    let touchStartY = 0;

    viewerImage.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true }
    );

    viewerImage.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;

        if (Math.abs(deltaX) < 45 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) {
          return;
        }

        if (deltaX > 0) {
          showPrevious();
        } else {
          showNext();
        }
      },
      { passive: true }
    );


    /* ==================================================
       Keyboard navigation
    ================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          !viewer.classList.contains(
            "is-open"
          )
        ) {

          return;

        }


        if (
          event.key === "Escape"
        ) {

          closeViewer();

        }


        if (
          event.key === "ArrowLeft"
        ) {

          showPrevious();

        }


        if (
          event.key === "ArrowRight"
        ) {

          showNext();

        }

      }
    );

  </script>

</body>

</html>