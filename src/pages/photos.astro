---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/photos.css";
import { Image } from "astro:assets";
import { photoMetadata } from "../data/photos";

const photoModules = import.meta.glob(
  "../assets/photos/*.{jpg,jpeg,png,webp,avif}",
  {
    eager: true,
    import: "default",
  }
);

const photos = Object.entries(photoModules)
  .map(([path, image]) => {
    const filename = path.split("/").pop() ?? "";
    const data = photoMetadata[filename] ?? {};

    return {
      image: image as import("astro").ImageMetadata,
      filename,
      alt: data.alt ?? "Photograph by Abhijith",
    };
  })
  .sort((a, b) =>
    a.filename.localeCompare(
      b.filename,
      undefined,
      { numeric: true }
    )
  );
---

<BaseLayout title="Photos — Abhijith" description="Photography by Abhijith." active="photos">


    <!-- ==================================================
         Photos
    ================================================== -->

    <section class="photos-page">

      <header class="photos-page-header">

        <h1>
          Photos
        </h1>

        <p>
          A small collection of things I've seen and photographed.
          <span class="photo-count">{photos.length} photographs</span>
        </p>

      </header>


      <div class="photo-grid">

        {
          photos.map((photo, index) => (

            <button
              class="photo"
              type="button"
              data-photo-index={index}
              data-photo-filename={photo.filename}
              data-photo-src={photo.image.src}
              aria-label={`Open photo ${index + 1} of ${photos.length}`}
            >

              <Image
                src={photo.image}
                alt={photo.alt}
                widths={[360, 540, 720]}
                sizes="(max-width: 700px) 50vw, 33vw"
                loading={index < 3 ? "eager" : "lazy"}
                decoding="async"
                quality={78}
              />

            </button>

          ))
        }

      </div>

    </section>


    <footer>

      <a href="/">
        ← Home
      </a>

    </footer>

<!-- ==================================================
       Fullscreen viewer
  ================================================== -->

  <div
    class="photo-viewer"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
    aria-hidden="true"
  >

    <button
      class="photo-viewer-close"
      type="button"
      aria-label="Close photo viewer"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="M5 5l14 14" />
        <path d="M19 5L5 19" />

      </svg>

    </button>


    <button
      class="photo-viewer-prev"
      type="button"
      aria-label="Previous photo"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="m15 18-6-6 6-6" />

      </svg>

    </button>


    <img
      class="photo-viewer-image"
      src=""
      alt=""
    />


    <div class="photo-viewer-meta">

      <div class="photo-viewer-meta-caption"></div>

      <div class="photo-viewer-meta-location"></div>

      <div class="photo-viewer-meta-details"></div>

    </div>


    <button
      class="photo-viewer-next"
      type="button"
      aria-label="Next photo"
    >

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
      >

        <path d="m9 18 6-6-6-6" />

      </svg>

    </button>


    <div
      class="photo-viewer-counter"
      aria-live="polite"
      aria-atomic="true"
    >

      <span class="photo-viewer-current">
        1
      </span>

      /

      <span class="photo-viewer-total">
        {photos.length}
      </span>

    </div>

  </div>


  <!-- Make server-side metadata available to browser JavaScript -->

  <script
    type="application/json"
    id="photo-metadata"
    set:html={JSON.stringify(photoMetadata)}
  ></script>


  <script is:inline>
    /* ==================================================
       Photo viewer
    ================================================== */

    const photoButtons =
      Array.from(
        document.querySelectorAll(".photo")
      );


    const viewer =
      document.querySelector(".photo-viewer");


    const viewerImage =
      document.querySelector(
        ".photo-viewer-image"
      );


    const viewerMeta =
      document.querySelector(
        ".photo-viewer-meta"
      );


    const viewerCaption =
      document.querySelector(
        ".photo-viewer-meta-caption"
      );


    const viewerLocation =
      document.querySelector(
        ".photo-viewer-meta-location"
      );


    const viewerDetails =
      document.querySelector(
        ".photo-viewer-meta-details"
      );


    const closeButton =
      document.querySelector(
        ".photo-viewer-close"
      );


    const previousButton =
      document.querySelector(
        ".photo-viewer-prev"
      );


    const nextButton =
      document.querySelector(
        ".photo-viewer-next"
      );


    const currentCounter =
      document.querySelector(
        ".photo-viewer-current"
      );


    const metadataElement =
      document.getElementById(
        "photo-metadata"
      );


    const metadata =
      metadataElement
        ? JSON.parse(
            metadataElement.textContent || "{}"
          )
        : {};


    let currentIndex = 0;
    let previouslyFocusedElement = null;


    /* ==================================================
       Optional metadata

       Metadata is matched using the image filename.

       Adding a new photo does NOT require adding
       anything here unless you want metadata.
    ================================================== */

    function updateMetadata(filename) {

      const data =
        metadata[filename];


      viewerMeta.classList.remove(
        "is-empty",
        "has-caption",
        "has-location",
        "has-details"
      );


      viewerCaption.textContent = "";

      viewerLocation.textContent = "";

      viewerDetails.textContent = "";


      if (!data) {

        viewerMeta.classList.add(
          "is-empty"
        );

        return;

      }


      const details = [
        data.date,
        data.camera,
        data.lens,
      ].filter(Boolean);


      if (data.caption) {

        viewerCaption.textContent =
          data.caption;

        viewerMeta.classList.add(
          "has-caption"
        );

      }


      if (data.location) {

        viewerLocation.textContent =
          data.location;

        viewerMeta.classList.add(
          "has-location"
        );

      }


      if (details.length > 0) {

        viewerDetails.textContent =
          details.join(" · ");

        viewerMeta.classList.add(
          "has-details"
        );

      }


      if (
        !data.caption &&
        !data.location &&
        details.length === 0
      ) {

        viewerMeta.classList.add(
          "is-empty"
        );

      }

    }


    function preloadAdjacentPhotos() {
      const indexes = [
        currentIndex - 1,
        currentIndex + 1,
      ];

      indexes.forEach((index) => {
        const wrapped =
          (index + photoButtons.length) % photoButtons.length;
        const src =
          photoButtons[wrapped]?.dataset.photoSrc;

        if (!src) return;

        const preload = new Image();
        preload.src = src;
      });
    }


    function showPhoto(index) {

      if (index < 0) {

        index =
          photoButtons.length - 1;

      }


      if (
        index >= photoButtons.length
      ) {

        index = 0;

      }


      currentIndex = index;


      const button =
        photoButtons[currentIndex];


      const image =
        button.querySelector("img");


      const filename =
        button.dataset.photoFilename || "";


      viewerImage.src =
        button.dataset.photoSrc ||
        image.currentSrc ||
        image.src;


      viewerImage.alt =
        image.alt;


      currentCounter.textContent =
        String(currentIndex + 1);


      updateMetadata(
        filename
      );


      if (!viewer.classList.contains("is-open")) {
        previouslyFocusedElement = document.activeElement;
      }


      viewer.classList.add(
        "is-open"
      );
      viewer.setAttribute("aria-hidden", "false");

      preloadAdjacentPhotos();


      document.body.classList.add(
        "viewer-open"
      );


      closeButton.focus();

    }


    function closeViewer() {

      viewer.classList.remove(
        "is-open"
      );
      viewer.setAttribute("aria-hidden", "true");


      document.body.classList.remove(
        "viewer-open"
      );


      viewerImage.src = "";

      viewerImage.alt = "";

      if (previouslyFocusedElement instanceof HTMLElement) {
        previouslyFocusedElement.focus();
      }

      previouslyFocusedElement = null;

    }


    function showPrevious() {

      showPhoto(
        currentIndex - 1
      );

    }


    function showNext() {

      showPhoto(
        currentIndex + 1
      );

    }


    /* ==================================================
       Open photos
    ================================================== */

    photoButtons.forEach(
      (button, index) => {

        button.addEventListener(
          "click",
          () => {

            showPhoto(index);

          }
        );

      }
    );


    /* ==================================================
       Viewer controls
    ================================================== */

    closeButton.addEventListener(
      "click",
      closeViewer
    );


    previousButton.addEventListener(
      "click",
      showPrevious
    );


    nextButton.addEventListener(
      "click",
      showNext
    );


    viewer.addEventListener(
      "click",
      (event) => {

        if (
          event.target === viewer
        ) {

          closeViewer();

        }

      }
    );


    /* ==================================================
       Touch swipe navigation
    ================================================== */

    let touchStartX = 0;
    let touchStartY = 0;

    viewerImage.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true }
    );

    viewerImage.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;

        if (Math.abs(deltaX) < 45 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) {
          return;
        }

        if (deltaX > 0) {
          showPrevious();
        } else {
          showNext();
        }
      },
      { passive: true }
    );


    /* ==================================================
       Keyboard navigation
    ================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          !viewer.classList.contains(
            "is-open"
          )
        ) {

          return;

        }


        if (event.key === "Tab") {
          const focusable = [
            closeButton,
            previousButton,
            nextButton,
          ];

          const current =
            focusable.indexOf(document.activeElement);

          if (event.shiftKey && current <= 0) {
            event.preventDefault();
            focusable[focusable.length - 1].focus();
          } else if (!event.shiftKey && current === focusable.length - 1) {
            event.preventDefault();
            focusable[0].focus();
          }
        }


        if (
          event.key === "Escape"
        ) {
          event.preventDefault();
          closeViewer();
        }


        if (
          event.key === "ArrowLeft"
        ) {
          event.preventDefault();
          showPrevious();
        }


        if (
          event.key === "ArrowRight"
        ) {
          event.preventDefault();
          showNext();
        }

      }
    );
</script>

</BaseLayout>
