---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import SiteHeader from "../../components/SiteHeader.astro";
import ThemeInit from "../../components/ThemeInit.astro";
import KeralaUrbanHealthCoverage from "../../components/KeralaUrbanHealthCoverage.astro";

const posts = await getCollection("blog");

const post = posts.find((entry) => entry.id === Astro.params.slug);

if (!post) {
  return Astro.redirect("/blog", 302);
}

const { Content } = await render(post);
const InteractiveComponent = post.data.layout === "interactive" && post.id === "kerala-urban-health-coverage"
  ? KeralaUrbanHealthCoverage
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ThemeInit />
<title>{post.data.title} — Abhijith</title>
    <meta name="description" content={post.data.description ?? `A blog post by Abhijith: ${post.data.title}`} />
  </head>

  <body>
    <main class="container">
      <SiteHeader active="blog" />

      <article class="post">
        <header class="post-header">
          <h1>{post.data.title}</h1>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-GB", { day:"2-digit", month:"short", year:"numeric" })}
          </time>
        </header>

        <div class="post-content">
          {InteractiveComponent ? <InteractiveComponent /> : <Content />}
        </div>
      </article>

      <footer class="post-footer">
        <a href="/blog">← Back to blog</a>
      </footer>
    </main>
</body>
</html>
