---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

const posts = await getCollection("blog");

const post = posts.find((entry) => entry.id === Astro.params.slug);

if (!post) {
  return Astro.redirect("/blog", 302);
}

const { Content } = await render(post);
---

<!doctype html>
<html lang="en">
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme");

        const theme =
          savedTheme ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <title>{post.data.title} — Abhijith</title>

    <meta
      name="description"
      content={`A blog post by Abhijith: ${post.data.title}`}
    />

    <style>
      /* ====================
         Profile / Site Brand
      ==================== */

      .site-brand {
        display: flex;
        align-items: center;

        gap: 10px;

        flex: 0 0 auto;

        color: inherit;
        text-decoration: none;

        line-height: 1;
      }


      .site-brand:hover {
        color: inherit;
        text-decoration: none;
      }


      .site-title {
        color: inherit;
        text-decoration: none;
      }


      /* ====================
         Profile Picture
      ==================== */

      .profile-pic {
        width: 36px;
        height: 36px;

        flex: 0 0 36px;

        padding: 2px;

        display: block;

        background: linear-gradient(
          135deg,
          #00e5ff 0%,
          #009cff 30%,
          #0066ff 58%,
          #3155ff 80%,
          #635bff 100%
        );

        border-radius: 50%;
      }


      .profile-pic img {
        display: block;

        width: 32px;
        height: 32px;

        margin: 0;
        padding: 0;

        object-fit: cover;

        border: 0;

        border-radius: 50%;
      }


      /* ====================
         Mobile Header
      ==================== */

      @media (max-width: 600px) {

        .site-header {
          gap: 8px;
        }


        .site-brand {
          gap: 6px;
        }


        .profile-pic {
          width: 26px;
          height: 26px;

          flex: 0 0 26px;

          padding: 2px;
        }


        .profile-pic img {
          width: 22px;
          height: 22px;
        }


        .site-title {
          font-size: 17px;
        }


        .header-right {
          gap: 6px;

          min-width: 0;
        }


        nav {
          gap: 8px;
        }


        nav a {
          font-size: 13px;
        }


        .theme-toggle {
          width: 18px;
          height: 18px;

          flex: 0 0 18px;
        }


        .theme-toggle svg {
          width: 15px;
          height: 15px;
        }

      }


      /* ====================
         Post Footer
      ==================== */

      .post-footer {
        margin-top: 50px;
      }


      @media (max-width: 600px) {

        .post-footer {
          margin-top: 45px;
        }

      }
    </style>

  </head>


  <body>

    <main class="container">


      <header class="site-header">


        <a href="/" class="site-brand">

          <span class="profile-pic">

            <img
              src="/profile.png"
              alt="Abhijith"
            />

          </span>


          <span class="site-title">
            Abhijith
          </span>

        </a>


        <div class="header-right">


          <nav>

            <a href="/">
              home
            </a>

            <a href="/blog" class="active">
              blog
            </a>

            <a href="/photos">
              photos
            </a>

            <a href="/now">
              now
            </a>

          </nav>


          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch to dark mode"
            title="Switch to dark mode"
          >

            <svg
              class="theme-icon-moon"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >

              <path
                d="M21 12.8A8.5 8.5 0 0 1 11.2 3a8.5 8.5 0 1 0 9.8 9.8Z"
              />

            </svg>


            <svg
              class="theme-icon-sun"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >

              <circle
                cx="12"
                cy="12"
                r="4"
              />

              <path d="M12 2v2" />
              <path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" />
              <path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" />
              <path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" />
              <path d="m19.07 4.93-1.41 1.41" />

            </svg>


            <span class="sr-only">
              Toggle colour theme
            </span>

          </button>

        </div>

      </header>


      <article class="post">


        <header class="post-header">

          <h1>
            {post.data.title}
          </h1>


          <time datetime={post.data.date.toISOString()}>

            {post.data.date.toLocaleDateString("en-GB", {
              day: "2-digit",
              month: "short",
              year: "numeric",
            })}

          </time>

        </header>


        <div class="post-content">
          <Content />
        </div>


      </article>


      <footer class="post-footer">

        <a href="/blog">
          ← Back to blog
        </a>

      </footer>


    </main>


    <script is:inline>

      const themeButton =
        document.querySelector(".theme-toggle");


      function updateThemeButton() {

        const isDark =
          document.documentElement.dataset.theme === "dark";


        themeButton.setAttribute(
          "aria-label",
          isDark
            ? "Switch to light mode"
            : "Switch to dark mode"
        );


        themeButton.setAttribute(
          "title",
          isDark
            ? "Switch to light mode"
            : "Switch to dark mode"
        );

      }


      themeButton.addEventListener("click", () => {

        const isDark =
          document.documentElement.dataset.theme === "dark";


        const newTheme =
          isDark
            ? "light"
            : "dark";


        document.documentElement.dataset.theme =
          newTheme;


        localStorage.setItem(
          "theme",
          newTheme
        );


        updateThemeButton();

      });


      updateThemeButton();

    </script>


  </body>
</html>