---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width"
  />

  <script is:inline>
    (() => {
      const savedTheme = localStorage.getItem("theme");

      const theme =
        savedTheme ||
        (
          window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches
            ? "dark"
            : "light"
        );

      document.documentElement.dataset.theme =
        theme;
    })();
  </script>

  <title>Now — Abhijith</title>

  <meta
    name="description"
    content="What Abhijith is currently working on, learning, and interested in."
  />

  <style>

    /* ==================================================
       Header / Profile
    ================================================== */

    .site-brand {
      display: flex;
      align-items: center;

      gap: 10px;

      flex: 0 0 auto;

      color: inherit;
      text-decoration: none;

      line-height: 1;
    }


    .site-brand:hover {
      color: inherit;
      text-decoration: none;
    }


    .site-brand .site-title {
      color: inherit;
      text-decoration: none;
    }


    .profile-pic {
      width: 36px;
      height: 36px;

      flex: 0 0 36px;

      padding: 2px;

      display: block;

      background: linear-gradient(
        135deg,
        #00e5ff 0%,
        #009cff 30%,
        #0066ff 58%,
        #3155ff 80%,
        #635bff 100%
      );

      border-radius: 50%;
    }


    .profile-pic img {
      display: block;

      width: 32px;
      height: 32px;

      margin: 0;
      padding: 0;

      object-fit: cover;

      border: 0;
      border-radius: 50%;
    }


    /* ==================================================
       Now page
    ================================================== */

    .now-page .now-intro {
      margin-bottom: 46px;
    }


    .now-section {
      padding: 22px 0 24px;

      border-top: 1px solid var(--border);
    }


    .now-section:first-of-type {
      border-top: 1px solid var(--border);
    }


    .now-section h2 {
      margin: 0 0 12px;

      color: var(--muted);

      font-size: 15px;
      line-height: 1.5;
      font-weight: 400;

      letter-spacing: -0.006em;
    }


    .now-section p {
      margin: 0;

      color: var(--text);

      font-size: 15px;
      line-height: 1.75;
      font-weight: 400;

      letter-spacing: -0.004em;
    }


    .now-page .updated {
      margin-top: 34px;
    }


    /* ==================================================
       Mobile
    ================================================== */

    @media (max-width: 600px) {

      .site-header {
        gap: 8px;
      }


      .site-brand {
        gap: 6px;
      }


      .profile-pic {
        width: 26px;
        height: 26px;

        flex: 0 0 26px;

        padding: 2px;
      }


      .profile-pic img {
        width: 22px;
        height: 22px;
      }


      .site-brand .site-title {
        font-size: 17px;
      }


      .header-right {
        gap: 6px;

        min-width: 0;
      }


      nav {
        gap: 8px;
      }


      nav a {
        font-size: 13px;
      }


      .theme-toggle {
        width: 18px;
        height: 18px;

        flex: 0 0 18px;
      }


      .theme-toggle svg {
        width: 15px;
        height: 15px;
      }


      .now-page .now-intro {
        margin-bottom: 38px;
      }


      .now-section {
        padding: 20px 0 22px;
      }


      .now-section h2 {
        margin-bottom: 11px;
      }


      .now-page .updated {
        margin-top: 30px;
      }

    }

  </style>

</head>


<body>

  <main class="container">


    <!-- ==================================================
         Header
    ================================================== -->

    <header class="site-header">

      <a
        href="/"
        class="site-brand"
        aria-label="Abhijith home"
      >

        <span class="profile-pic">

          <img
            src="/profile.png"
            alt="Abhijith"
          />

        </span>

        <span class="site-title">
          Abhijith
        </span>

      </a>


      <div class="header-right">

        <nav>

          <a href="/">
            home
          </a>

          <a href="/blog">
            blog
          </a>

          <a href="/photos">
            photos
          </a>

          <a
            href="/now"
            class="active"
          >
            now
          </a>

        </nav>


        <button
          class="theme-toggle"
          type="button"
          aria-label="Switch to dark mode"
          title="Switch to dark mode"
        >

          <svg
            class="theme-icon-moon"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >

            <path
              d="M21 12.8A8.5 8.5 0 0 1 11.2 3a8.5 8.5 0 1 0 9.8 9.8Z"
            />

          </svg>


          <svg
            class="theme-icon-sun"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >

            <circle
              cx="12"
              cy="12"
              r="4"
            />

            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41-1.41" />

          </svg>


          <span class="sr-only">
            Toggle colour theme
          </span>

        </button>

      </div>

    </header>


    <!-- ==================================================
         Now
    ================================================== -->

    <article class="now-page">

      <h1>
        Now
      </h1>


      <p class="now-intro">
        This is what I'm currently working on, learning, watching, and
        thinking about.
      </p>


      <section class="now-section">

        <h2>
          Working on
        </h2>

        <p>
          Building this little corner of the internet and figuring out how I
          want it to look and feel.
        </p>

      </section>


      <section class="now-section">

        <h2>
          Learning
        </h2>

        <p>
          Exploring web development, data, and whatever else catches my
          attention.
        </p>

      </section>


      <section class="now-section">

        <h2>
          Watching
        </h2>

        <p>
          Movies, as usual. I'm also keeping track of what I watch on
          Letterboxd.
        </p>

      </section>


      <p class="updated">
        Last updated: September 2026
      </p>

    </article>


    <footer>

      <a href="/">
        ← Home
      </a>

    </footer>

  </main>


  <script is:inline>

    /* ==================================================
       Theme switcher
    ================================================== */

    const themeButton =
      document.querySelector(".theme-toggle");


    function updateThemeButton() {

      const isDark =
        document.documentElement.dataset.theme === "dark";


      themeButton.setAttribute(
        "aria-label",
        isDark
          ? "Switch to light mode"
          : "Switch to dark mode"
      );


      themeButton.setAttribute(
        "title",
        isDark
          ? "Switch to light mode"
          : "Switch to dark mode"
      );

    }


    themeButton.addEventListener(
      "click",
      () => {

        const isDark =
          document.documentElement.dataset.theme === "dark";


        const newTheme =
          isDark
            ? "light"
            : "dark";


        document.documentElement.dataset.theme =
          newTheme;


        localStorage.setItem(
          "theme",
          newTheme
        );


        updateThemeButton();

      }
    );


    updateThemeButton();

  </script>

</body>

</html>