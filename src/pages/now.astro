---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/now.css";
---

<BaseLayout
  title="Now — Abhijith"
  description="What Abhijith is currently working on, learning, and interested in."
  active="now"
>
  <article class="now-page">
    <header class="now-header">
      <h1>Now</h1>
      <p class="now-intro">
        This is what I'm currently working on, learning, watching, and thinking about.
      </p>
    </header>

    <div class="now-sections">
      <section class="now-section">
        <div class="now-section-label">Working on</div>
        <div class="now-section-content">
          <p>
            Building this little corner of the internet and figuring out how I want it to look and feel.
          </p>
        </div>
      </section>

      <section class="now-section">
        <div class="now-section-label">Learning</div>
        <div class="now-section-content">
          <p>
            Exploring web development, data, and whatever else catches my attention.
          </p>
        </div>
      </section>

      <section class="now-section">
        <div class="now-section-label">Watching</div>
        <div class="now-section-content">
          <p>
            Movies, as usual. I'm also keeping track of what I watch on Letterboxd.
          </p>
        </div>
      </section>
    </div>

    <footer class="now-meta">
      <span>Last updated</span>
      <time datetime="2026-09">September 2026</time>
    </footer>
  </article>

  <footer class="now-footer">
    <a href="/">← Home</a>
  </footer>
</BaseLayout>
