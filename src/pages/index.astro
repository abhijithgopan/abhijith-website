        height: 4px;
        border-top: 1.5px solid #00a9c7;
        border-radius: 50%;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 280ms cubic-bezier(.2,.8,.2,1);
      }

      .movie-card:hover .movie-title::after {
        transform: scaleX(1);
      }

      .movie-meta {
        display: flex;
