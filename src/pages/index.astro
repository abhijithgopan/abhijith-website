        white-space: nowrap;
      }

      @media (max-width: 600px) {
        .recent-movies {
          margin-top: 48px;
        }

        .movie-strip {
          display: flex;
          overflow-x: auto;
          gap: 14px;
          padding-bottom: 6px;
          margin-right: -18px;
          padding-right: 18px;
          scrollbar-width: none;
        }

        .movie-strip::-webkit-scrollbar {
          display: none;
        }

        .movie-card {
          flex: 0 0 118px;
        }

        .movie-meta {
          display: block;
        }

        .movie-date {
          display: block;
          margin-top: 2px;
        }
      }

      @media (max-width: 600px) {

        .site-header {
          gap: 8px;
        }


        .site-brand {
          gap: 6px;
        }


        .profile-pic {
          width: 26px;
          height: 26px;

          flex: 0 0 26px;

          padding: 2px;
        }


        .profile-pic img {
          width: 22px;
          height: 22px;
