---
import { getCollection } from "astro:content";
import "../styles/global.css";

const posts = await getCollection("blog");

posts.sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);

const postsByYear = posts.reduce<Record<string, typeof posts>>(
  (groups, post) => {
    const year = post.data.date.getFullYear().toString();

    if (!groups[year]) {
      groups[year] = [];
    }

    groups[year].push(post);

    return groups;
  },
  {}
);

const years = Object.keys(postsByYear).sort(
  (a, b) => Number(b) - Number(a)
);
---

<!doctype html>
<html lang="en">
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme");

        const theme =
          savedTheme ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <title>Abhijith</title>

    <meta
      name="description"
      content="The personal website of Abhijith."
    />

    <style>
      /* ====================
         Profile / Site Brand
      ==================== */

      .site-brand {
        display: flex;
        align-items: center;

        gap: 10px;

        flex: 0 0 auto;

        color: inherit;
        text-decoration: none;

        line-height: 1;
      }


      .site-brand:hover {
        color: inherit;
        text-decoration: none;
      }


      .site-title {
        color: inherit;
        text-decoration: none;
      }


      /* ====================
         Profile Picture
      ==================== */

      .profile-pic {
        width: 36px;
        height: 36px;

        flex: 0 0 36px;

        padding: 2px;

        display: block;

        background: linear-gradient(
          135deg,
          #00e5ff 0%,
          #009cff 30%,
          #0066ff 58%,
          #3155ff 80%,
          #635bff 100%
        );

        border-radius: 50%;
      }


      .profile-pic img {
        display: block;

        width: 32px;
        height: 32px;

        margin: 0;
        padding: 0;

        object-fit: cover;

        border: 0;

        border-radius: 50%;
      }


      /* ====================
         Weather Footer
      ==================== */

      .weather-footer {
        margin-top: 34px;

        padding-top: 24px;

        border-top: 1px solid var(--border);
      }


      .weather-status {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 24px;

        min-height: 76px;
      }


      .weather-copy {
        min-width: 0;
      }


      .weather-location {
        margin: 0 0 3px;

        color: var(--text);

        font-size: 15px;
        line-height: 1.5;
        font-weight: 400;

        letter-spacing: -0.004em;
      }


      .weather-details {
        margin: 0;

        color: var(--muted);

        font-size: 13px;
        line-height: 1.5;
        font-weight: 400;

        letter-spacing: -0.003em;
      }


      .weather-animation {
        position: relative;

        width: 112px;
        height: 64px;

        flex: 0 0 112px;

        overflow: hidden;
      }


      /* ====================
         Weather Scene
      ==================== */

      .weather-scene {
        position: absolute;

        inset: 0;
      }


      .weather-sun {
        position: absolute;

        top: 11px;
        right: 20px;

        width: 28px;
        height: 28px;

        border: 1px solid var(--muted);
        border-radius: 50%;

        opacity: 0.75;

        animation: weather-sun-pulse 5s ease-in-out infinite;
      }


      .weather-sun::before,
      .weather-sun::after {
        content: "";

        position: absolute;

        inset: -7px;

        border: 1px solid var(--border);

        border-radius: 50%;
      }


      .weather-sun::after {
        inset: -13px;

        border-color: transparent;
        border-top-color: var(--border);
        border-bottom-color: var(--border);
      }


      .weather-cloud {
        position: absolute;

        left: 10px;
        bottom: 13px;

        width: 56px;
        height: 18px;

        border: 1px solid var(--muted);
        border-radius: 18px;

        background: var(--background);

        opacity: 0.9;

        animation: weather-cloud-drift 7s ease-in-out infinite;
      }


      .weather-cloud::before,
      .weather-cloud::after {
        content: "";

        position: absolute;

        bottom: 5px;

        border: 1px solid var(--muted);
        border-bottom: 0;

        border-radius: 50% 50% 0 0;

        background: var(--background);
      }


      .weather-cloud::before {
        left: 10px;

        width: 22px;
        height: 22px;
      }


      .weather-cloud::after {
        left: 27px;

        width: 16px;
        height: 16px;
      }


      .weather-rain {
        position: absolute;

        left: 22px;
        bottom: 2px;

        width: 1px;
        height: 9px;

        background: var(--muted);

        opacity: 0;

        transform: rotate(18deg);

        animation: weather-rain-fall 1.1s linear infinite;
      }


      .weather-rain::before,
      .weather-rain::after {
        content: "";

        position: absolute;

        width: 1px;
        height: 7px;

        background: var(--muted);
      }


      .weather-rain::before {
        left: 13px;
        top: 4px;
      }


      .weather-rain::after {
        left: 26px;
        top: -2px;
      }


      .weather-fog {
        position: absolute;

        left: 8px;
        bottom: 10px;

        width: 76px;
        height: 1px;

        background: var(--muted);

        opacity: 0;

        animation: weather-fog-drift 5s ease-in-out infinite;
      }


      .weather-fog::before,
      .weather-fog::after {
        content: "";

        position: absolute;

        left: 10px;

        width: 60px;
        height: 1px;

        background: var(--muted);
      }


      .weather-fog::before {
        top: -8px;
      }


      .weather-fog::after {
        top: 8px;
      }


      .weather-snow {
        position: absolute;

        left: 25px;
        bottom: 3px;

        width: 4px;
        height: 4px;

        border: 1px solid var(--muted);
        border-radius: 50%;

        opacity: 0;

        animation: weather-snow-fall 2.8s linear infinite;
      }


      .weather-snow::before,
      .weather-snow::after {
        content: "";

        position: absolute;

        width: 4px;
        height: 4px;

        border: 1px solid var(--muted);
        border-radius: 50%;
      }


      .weather-snow::before {
        left: 18px;
        top: -9px;
      }


      .weather-snow::after {
        left: 37px;
        top: -3px;
      }


      /* ====================
         Weather States
      ==================== */

      .weather-scene[data-weather="clear"] .weather-cloud,
      .weather-scene[data-weather="clear"] .weather-rain,
      .weather-scene[data-weather="clear"] .weather-fog,
      .weather-scene[data-weather="clear"] .weather-snow {
        display: none;
      }


      .weather-scene[data-weather="cloudy"] .weather-sun {
        opacity: 0.3;
      }


      .weather-scene[data-weather="rain"] .weather-sun,
      .weather-scene[data-weather="rain"] .weather-snow,
      .weather-scene[data-weather="rain"] .weather-fog {
        display: none;
      }


      .weather-scene[data-weather="rain"] .weather-rain {
        opacity: 0.65;
      }


      .weather-scene[data-weather="fog"] .weather-sun,
      .weather-scene[data-weather="fog"] .weather-cloud,
      .weather-scene[data-weather="fog"] .weather-rain,
      .weather-scene[data-weather="fog"] .weather-snow {
        display: none;
      }


      .weather-scene[data-weather="fog"] .weather-fog {
        opacity: 0.55;
      }


      .weather-scene[data-weather="snow"] .weather-sun,
      .weather-scene[data-weather="snow"] .weather-rain,
      .weather-scene[data-weather="snow"] .weather-fog {
        display: none;
      }


      .weather-scene[data-weather="snow"] .weather-snow {
        opacity: 0.7;
      }


      .weather-scene[data-weather="storm"] .weather-sun,
      .weather-scene[data-weather="storm"] .weather-snow,
      .weather-scene[data-weather="storm"] .weather-fog {
        display: none;
      }


      .weather-scene[data-weather="storm"] .weather-rain {
        opacity: 0.8;
        animation-duration: 0.7s;
      }


      .weather-scene[data-weather="storm"] {
        animation: weather-storm-flash 6s ease-in-out infinite;
      }


      /* ====================
         Footer Distance
      ==================== */

      .visitor-distance {
        margin: 18px 0 0;

        color: var(--muted);

        font-size: 13px;
        line-height: 1.5;
        font-weight: 400;

        letter-spacing: -0.003em;
      }


      .visitor-distance.visible {
        display: block;
      }


      .visitor-distance.hidden {
        display: none;
      }


      /* ====================
         Mobile Header
      ==================== */

      @media (max-width: 600px) {

        .site-header {
          gap: 8px;
        }


        .site-brand {
          gap: 6px;
        }


        .profile-pic {
          width: 26px;
          height: 26px;

          flex: 0 0 26px;

          padding: 2px;
        }


        .profile-pic img {
          width: 22px;
          height: 22px;
        }


        .site-title {
          font-size: 17px;
        }


        .header-right {
          gap: 6px;

          min-width: 0;
        }


        nav {
          gap: 8px;
        }


        nav a {
          font-size: 13px;
        }


        .theme-toggle {
          width: 18px;
          height: 18px;

          flex: 0 0 18px;
        }


        .theme-toggle svg {
          width: 15px;
          height: 15px;
        }


        .weather-footer {
          margin-top: 30px;

          padding-top: 20px;
        }


        .weather-status {
          gap: 14px;

          min-height: 64px;
        }


        .weather-location {
          font-size: 15px;
        }


        .weather-details {
          font-size: 13px;
        }


        .weather-animation {
          width: 86px;
          height: 56px;

          flex: 0 0 86px;
        }


        .weather-sun {
          top: 7px;
          right: 10px;

          width: 24px;
          height: 24px;
        }


        .weather-cloud {
          left: 3px;
          bottom: 10px;

          width: 48px;
        }


        .visitor-distance {
          margin-top: 15px;
        }

      }


      /* ====================
         Weather Animations
      ==================== */

      @keyframes weather-sun-pulse {

        0%,
        100% {
          transform: scale(1);
        }

        50% {
          transform: scale(1.06);
        }

      }


      @keyframes weather-cloud-drift {

        0%,
        100% {
          transform: translateX(0);
        }

        50% {
          transform: translateX(8px);
        }

      }


      @keyframes weather-rain-fall {

        0% {
          transform: translateY(-8px) rotate(18deg);
        }

        100% {
          transform: translateY(12px) rotate(18deg);
        }

      }


      @keyframes weather-fog-drift {

        0%,
        100% {
          transform: translateX(-5px);
        }

        50% {
          transform: translateX(8px);
        }

      }


      @keyframes weather-snow-fall {

        0% {
          transform: translateY(-14px);
        }

        100% {
          transform: translateY(12px);
        }

      }


      @keyframes weather-storm-flash {

        0%,
        92%,
        100% {
          opacity: 1;
        }

        94% {
          opacity: 0.72;
        }

        96% {
          opacity: 1;
        }

      }


      @media (prefers-reduced-motion: reduce) {

        .weather-sun,
        .weather-cloud,
        .weather-rain,
        .weather-fog,
        .weather-snow,
        .weather-scene {
          animation: none;
        }

      }



      /* ====================
         Musings hand-drawn outline
      ==================== */

      .writing h2.musings-title {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        width: 120px;
        height: 54px;
        margin: 0 0 18px;
        padding: 0;
        color: var(--muted);
        font-size: 16px;
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.004em;
      }

      .writing h2.musings-title > span {
        position: relative;
        z-index: 2;
      }

      .musings-outline {
        position: absolute;
        top: -4px;
        left: -8px;
        width: 112px;
        height: 48px;
        overflow: visible;
        pointer-events: none;
      }

      .musings-outline path {
        fill: none;
        stroke: #18bdf2;
        stroke-width: 2.4;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .musings-outline .outline-ring {
        stroke-dasharray: 290;
        stroke-dashoffset: 290;
        animation: musings-draw 5.8s ease-in-out infinite;
      }

      .musings-outline .outline-tail {
        stroke-width: 2.4;
        stroke-dasharray: 24;
        stroke-dashoffset: 24;
        animation: musings-tail-draw 5.8s ease-in-out infinite;
      }

      @keyframes musings-draw {
        0% {
          stroke-dashoffset: 290;
          opacity: 0.12;
        }
        10% {
          opacity: 0.85;
        }
        76% {
          stroke-dashoffset: 0;
          opacity: 0.85;
        }
        88% {
          stroke-dashoffset: 0;
          opacity: 0.72;
        }
        100% {
          stroke-dashoffset: 290;
          opacity: 0.12;
        }
      }

      @keyframes musings-tail-draw {
        0% {
          stroke-dashoffset: 24;
          opacity: 0.12;
        }
        10% {
          opacity: 0.85;
        }
        76% {
          stroke-dashoffset: 0;
          opacity: 0.85;
        }
        88% {
          stroke-dashoffset: 0;
          opacity: 0.72;
        }
        100% {
          stroke-dashoffset: 24;
          opacity: 0.12;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .musings-outline path {
          animation: none;
          stroke-dasharray: none;
          stroke-dashoffset: 0;
          opacity: 0.7;
        }
      }


      /* ====================
         Writing post hover
      ==================== */

      .writing-post {
        position: relative;
      }

      .writing-post-title {
        position: relative;
        display: inline-block;
        text-decoration: none;
      }

      .writing-post:hover,
      .writing-post:focus-visible {
        text-decoration: none;
      }

      .writing-post:hover .writing-post-title,
      .writing-post:focus-visible .writing-post-title {
        text-decoration: none;
      }

      /* A loose pen stroke rather than a conventional underline. */
      .writing-post-title::after {
        content: "";
        position: absolute;
        left: -3px;
        right: -4px;
        bottom: -6px;
        height: 7px;
        pointer-events: none;
        opacity: 0;
        transform: rotate(-0.7deg) scaleX(0.02);
        transform-origin: left center;
        background: #18bdf2;
        clip-path: polygon(
          0 43%,
          10% 35%,
          21% 48%,
          32% 39%,
          44% 47%,
          57% 34%,
          69% 45%,
          81% 37%,
          92% 48%,
          100% 41%,
          100% 67%,
          90% 61%,
          79% 72%,
          67% 61%,
          55% 70%,
          43% 60%,
          31% 69%,
          19% 59%,
          8% 68%,
          0 60%
        );
      }

      .writing-post:hover .writing-post-title::after,
      .writing-post:focus-visible .writing-post-title::after {
        animation: ink-spill 520ms cubic-bezier(0.22, 0.8, 0.2, 1) forwards;
      }

      @keyframes ink-spill {
        0% {
          opacity: 0;
          transform: rotate(-0.7deg) scaleX(0.02);
        }

        12% {
          opacity: 0.82;
        }

        72% {
          opacity: 0.72;
          transform: rotate(-0.7deg) scaleX(1.015);
        }

        100% {
          opacity: 0.62;
          transform: rotate(0.15deg) scaleX(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .writing-post-title::after {
          transition: none;
          animation: none !important;
        }

        .writing-post:hover .writing-post-title::after,
        .writing-post:focus-visible .writing-post-title::after {
          opacity: 0.62;
          transform: rotate(0.15deg) scaleX(1);
        }
      }


      @media (max-width: 600px) {
        .writing h2.musings-title {
          width: 120px;
          height: 54px;
          font-size: 16px;
          margin-bottom: 16px;
        }

        .musings-outline {
          top: -4px;
          left: -8px;
          width: 112px;
          height: 48px;
        }
      }

    </style>

  </head>


  <body>

    <main class="container">


      <header class="site-header">


        <a href="/" class="site-brand">

          <span class="profile-pic">

            <img
              src="/profile.png"
              alt="Abhijith"
            />

          </span>


          <span class="site-title">
            Abhijith
          </span>

        </a>


        <div class="header-right">


          <nav>

            <a href="/" class="active">
              home
            </a>

            <a href="/blog">
              blog
            </a>

            <a href="/photos">
              photos
            </a>

            <a href="/now">
              now
            </a>

          </nav>


          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch to dark mode"
            title="Switch to dark mode"
          >

            <svg
              class="theme-icon-moon"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >

              <path
                d="M21 12.8A8.5 8.5 0 0 1 11.2 3a8.5 8.5 0 1 0 9.8 9.8Z"
              />

            </svg>


            <svg
              class="theme-icon-sun"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >

              <circle
                cx="12"
                cy="12"
                r="4"
              />

              <path d="M12 2v2" />
              <path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" />
              <path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" />
              <path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" />
              <path d="m19.07 4.93-1.41 1.41" />

            </svg>


            <span class="sr-only">
              Toggle colour theme
            </span>

          </button>

        </div>

      </header>


      <article class="intro">



        <p>
        Living in the most chaotic city in India and growing this tiny space in the world wide web.
      
        You won't see nothing interesting here just some random thoughts and random clicks :/
        </p>


    


      </article>


      <section class="writing">


        <h2 class="musings-title">
          <span>Musings</span>
          <svg
            class="musings-outline"
            viewBox="0 0 120 60"
            aria-hidden="true"
          >
            <path
              class="outline-ring"
              d="M 8 31 C 6 24, 15 16, 31 12 C 48 7, 72 9, 89 14 C 105 19, 114 26, 113 32 C 112 39, 101 45, 87 48 C 69 52, 47 52, 30 48 C 15 45, 7 39, 8 31 Z"
            />
            <path
              class="outline-tail"
              d="M 7 29 C 8 22, 13 17, 20 14"
            />
          </svg>
        </h2>


        <div class="writing-list">


          {
            years.map((year) => (

              <section class="year-group">


                <div class="year-label">
                  {year}
                </div>


                <div class="year-posts">


                  {
                    postsByYear[year].map((post) => (

                      <a
                        href={`/blog/${post.id}`}
                        class="writing-post"
                      >

                        <span class="writing-post-title">
                          {post.data.title}
                        </span>


                        <time>

                          {String(
                            post.data.date.getDate()
                          ).padStart(2, "0")}

                          /

                          {String(
                            post.data.date.getMonth() + 1
                          ).padStart(2, "0")}

                        </time>

                      </a>

                    ))
                  }


                </div>

              </section>

            ))
          }


        </div>


      </section>


      <footer class="weather-footer">

        <div class="weather-status">


          <div class="weather-copy">

            <p
              class="weather-location"
              id="my-location"
            >
              Delhi
            </p>


            <p
              class="weather-details"
              id="my-weather"
            >
              Loading weather…
            </p>

          </div>


          <div
            class="weather-animation"
            aria-hidden="true"
          >

            <div
              class="weather-scene"
              id="weather-scene"
              data-weather="cloudy"
            >

              <div class="weather-sun"></div>

              <div class="weather-cloud"></div>

              <div class="weather-rain"></div>

              <div class="weather-fog"></div>

              <div class="weather-snow"></div>

            </div>

          </div>


        </div>


        <p
          class="visitor-distance hidden"
