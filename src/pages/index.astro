---
import { getCollection } from "astro:content";
import "../styles/global.css";

const posts = await getCollection("blog");

posts.sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf()
);

const postsByYear = posts.reduce<Record<string, typeof posts>>(
  (groups, post) => {
    const year = post.data.date.getFullYear().toString();

    if (!groups[year]) {
      groups[year] = [];
    }

    groups[year].push(post);

    return groups;
  },
  {}
);

const years = Object.keys(postsByYear).sort(
  (a, b) => Number(b) - Number(a)
);

const letterboxdFallback = [
  {
    title: "Vishwanath & Sons",
    rating: 3,
    date: "2026-09-11",
    link: "https://letterboxd.com/abhijithgopan/film/vishwanath-sons/",
    poster: ""
  },
  {
    title: "DC",
    rating: 3,
    date: "2026-09-04",
    link: "https://letterboxd.com/abhijithgopan/film/dc/",
    poster: ""
  },
  {
    title: "I, Nobody",
    rating: 2,
    date: "2026-08-30",
    link: "https://letterboxd.com/abhijithgopan/film/i-nobody/",
    poster: ""
  },
  {
    title: "Con City",
    rating: 2.5,
    date: "2026-08-24",
    link: "https://letterboxd.com/abhijithgopan/film/con-city/",
    poster: ""
  }
];

const decodeHtml = (value: string) =>
  value
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">");

const extractTag = (item: string, tag: string) => {
  const match = item.match(
    new RegExp(`<${tag}>([\\s\\S]*?)</${tag}>`, "i")
  );

  return match ? decodeHtml(match[1].trim()) : "";
};

const ratingStars = (rating: number) => {
  const fullStars = Math.floor(rating);
  const halfStar = rating % 1 === 0.5 ? "½" : "";

  return "★".repeat(fullStars) + halfStar;
};

const formatMovieDate = (date: string) => {
  const [year, month, day] = date.split("-").map(Number);
  const value = new Date(year, month - 1, day);

  return value.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short"
  });
};

let recentMovies = letterboxdFallback;

try {
  const letterboxdResponse = await fetch(
    "https://letterboxd.com/abhijithgopan/rss/"
  );

  if (letterboxdResponse.ok) {
    const xml = await letterboxdResponse.text();
    const items = xml.match(/<item>[\s\S]*?<\/item>/gi) ?? [];

    const movies = items
      .map((item) => {
        const title = extractTag(item, "letterboxd:filmTitle");
        const rating = Number(
          extractTag(item, "letterboxd:memberRating")
        );
        const date = extractTag(item, "letterboxd:watchedDate");
        const link = extractTag(item, "link");
        const description = extractTag(item, "description");
        const posterMatch = description.match(
          /<img[^>]+src=["']([^"']+)["']/i
        );

        if (!title || !date || !Number.isFinite(rating) || !link) {
          return null;
        }

        return {
          title,
          rating,
          date,
          link,
          poster: posterMatch?.[1] ?? ""
        };
      })
      .filter((movie): movie is NonNullable<typeof movie> => movie !== null)
      .slice(0, 4);

    if (movies.length === 4) {
      recentMovies = movies;
    }
  }
} catch {
  // Keep the last known four films if Letterboxd is unavailable during a build.
}
---

<!doctype html>
<html lang="en">
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("theme");

        const theme =
          savedTheme ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");

        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <title>Abhijith</title>

    <meta
      name="description"
      content="The personal website of Abhijith."
    />

    <style>
      /* ====================
         Profile / Site Brand
      ==================== */

      .site-brand {
        display: flex;
        align-items: center;

        gap: 10px;

        flex: 0 0 auto;

        color: inherit;
        text-decoration: none;

        line-height: 1;
      }


      .site-brand:hover {
        color: inherit;
        text-decoration: none;
      }


      .site-title {
        color: inherit;
        text-decoration: none;
      }


      /* ====================
         Profile Picture
      ==================== */

      .profile-pic {
        width: 36px;
        height: 36px;

        flex: 0 0 36px;

        padding: 2px;

        display: block;

        background: linear-gradient(
          135deg,
          #00e5ff 0%,
          #009cff 30%,
          #0066ff 58%,
          #3155ff 80%,
          #635bff 100%
        );

        border-radius: 50%;
      }


      .profile-pic img {
        display: block;

        width: 32px;
        height: 32px;

        margin: 0;
        padding: 0;

        object-fit: cover;

        border: 0;

        border-radius: 50%;
      }


      /* ====================
         Weather Footer
      ==================== */

      .weather-footer {
        position: relative;
        margin-top: 34px;
        padding-top: 24px;
        min-height: 230px;
        overflow: hidden;
        border-top: 1px solid var(--border);
        isolation: isolate;
      }
      .delhi-skyline {
        position: absolute;
        z-index: 1;
        left: -8%;
        bottom: -8px;
        width: 116%;
        height: 195px;
        display: block;
        opacity: 0.40;
        pointer-events: none;
      }

      [data-theme="dark"] .delhi-skyline {
        opacity: 0.25;
      }
      .weather-status {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        min-height: 76px;
      }


      .weather-copy {
  position: relative;
  z-index: 4;
  min-width: 0;
  padding-top: 28px;
}

.weather-location {
  margin: 0 0 4px;
  color: var(--text);
  font-size: 17px;
  line-height: 1.4;
  font-weight: 400;
  letter-spacing: -0.01em;
}

.weather-details {
  margin: 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.5;
  font-weight: 400;
  letter-spacing: 0;
}


      .weather-animation {
        position: absolute;
        z-index: 3;
        top: 0;
        right: 0;
        width: 42%;
        height: 150px;
        overflow: visible;
        pointer-events: none;
      }


      .weather-scene {
        position: absolute;
        inset: 0;
      }


      /* Prominent but still minimalist weather illustration */
      .weather-sun {
        position: absolute;
        top: 25px;
        right: 12%;
        width: 52px;
        height: 52px;
        z-index: 4;
        border: 1px solid #d3a34f;
        border-radius: 50%;
        background: #f0c76f;
        opacity: 0.82;
        animation: weather-sun-pulse 4s ease-in-out infinite;
      }


      .weather-sun::before,
      .weather-sun::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
      }


      .weather-sun::before {
        inset: -9px;
        border: 1px solid #d3a34f;
        opacity: 0.42;
      }


      .weather-sun::after {
        inset: -17px;
        border: 1px solid transparent;
        border-top-color: #d3a34f;
        border-bottom-color: #d3a34f;
        opacity: 0.34;
      }


      [data-theme="dark"] .weather-sun {
        border-color: #d9ae5b;
        background: #d9ae5b;
        opacity: 0.76;
      }


      .weather-cloud {
        position: absolute;
        left: 24%;
        top: 58px;
        width: 78px;
        height: 20px;
        border: 1px solid var(--muted);
        border-radius: 18px;
        background: var(--background);
        opacity: 0.92;
        animation: weather-cloud-drift 7s ease-in-out infinite;
      }


      .weather-cloud::before,
      .weather-cloud::after {
        content: "";
        position: absolute;
        bottom: 5px;
        border: 1px solid var(--muted);
        border-bottom: 0;
        border-radius: 50% 50% 0 0;
        background: var(--background);
      }


      .weather-cloud::before {
        left: 10px;
        width: 24px;
        height: 24px;
      }


      .weather-cloud::after {
        left: 30px;
        width: 18px;
        height: 18px;
      }


      .weather-rain {
        position: absolute;
        left: 29%;
        top: 88px;
        width: 1.5px;
        height: 11px;
        background: var(--muted);
        opacity: 0;
        transform: rotate(18deg);
        animation: weather-rain-fall 1.1s linear infinite;
      }


      .weather-rain::before,
      .weather-rain::after {
        content: "";
        position: absolute;
        width: 1.5px;
        height: 8px;
        background: var(--muted);
      }


      .weather-rain::before {
        left: 14px;
        top: 4px;
      }


      .weather-rain::after {
        left: 28px;
        top: -2px;
      }


      .weather-fog {
        position: absolute;
        left: 12%;
        top: 92px;
        width: 125px;
        height: 2px;
        background: var(--muted);
        opacity: 0;
        animation: weather-fog-drift 5s ease-in-out infinite;
      }


      .weather-fog::before,
      .weather-fog::after {
        content: "";
        position: absolute;
        left: 10px;
        width: 100px;
        height: 2px;
        background: var(--muted);
      }


      .weather-fog::before {
        top: -9px;
      }


      .weather-fog::after {
        top: 9px;
      }


      .weather-snow {
        position: absolute;
        left: 29%;
        top: 84px;
        width: 5px;
        height: 5px;
        border: 1px solid var(--muted);
        border-radius: 50%;
        opacity: 0;
        animation: weather-snow-fall 2.8s linear infinite;
      }


      .weather-snow::before,
      .weather-snow::after {
        content: "";
        position: absolute;
        width: 5px;
        height: 5px;
        border: 1px solid var(--muted);
        border-radius: 50%;
      }


      .weather-snow::before {
        left: 18px;
        top: -9px;
      }


      .weather-snow::after {
        left: 37px;
        top: -3px;
      }


      /* ====================
         Weather States
      ==================== */

      .weather-scene[data-weather="clear"] .weather-cloud,
      .weather-scene[data-weather="clear"] .weather-rain,
      .weather-scene[data-weather="clear"] .weather-fog,
      .weather-scene[data-weather="clear"] .weather-snow {
        display: none;
      }


      .weather-scene[data-weather="cloudy"] .weather-sun {
        opacity: 0.46;
      }


      .weather-scene[data-weather="rain"] .weather-sun,
      .weather-scene[data-weather="rain"] .weather-snow,
      .weather-scene[data-weather="rain"] .weather-fog {
        display: none;
      }


      .weather-scene[data-weather="rain"] .weather-rain {
        opacity: 0.82;
      }


      .weather-scene[data-weather="fog"] .weather-sun,
      .weather-scene[data-weather="fog"] .weather-cloud,
      .weather-scene[data-weather="fog"] .weather-rain,
      .weather-scene[data-weather="fog"] .weather-snow {
        display: none;
      }


      .weather-scene[data-weather="fog"] .weather-fog {
        opacity: 0.68;
      }


      .weather-scene[data-weather="snow"] .weather-sun,
      .weather-scene[data-weather="snow"] .weather-rain,
      .weather-scene[data-weather="snow"] .weather-fog {
        display: none;
      }


      .weather-scene[data-weather="snow"] .weather-snow {
        opacity: 0.80;
      }


      .weather-scene[data-weather="storm"] .weather-sun,
      .weather-scene[data-weather="storm"] .weather-snow,
      .weather-scene[data-weather="storm"] .weather-fog {
        display: none;
      }


      .weather-scene[data-weather="storm"] .weather-rain {
        opacity: 0.92;
        animation-duration: 0.7s;
      }


      .weather-scene[data-weather="storm"] {
        animation: weather-storm-flash 6s ease-in-out infinite;
      }


      /* ====================
         Footer Distance
      ==================== */

     .visitor-distance {
  position: relative;
  z-index: 4;
  margin: 32px 0 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.5;
  font-weight: 400;
  letter-spacing: 0;
}


      .visitor-distance.visible {
        display: block;
      }


      .visitor-distance.hidden {
        display: none;
      }

.weather-footer > a {
  position: relative;
  z-index: 4;
  display: inline-block;
  margin-top: 3px;
  font-size: 12.5px;
  color: var(--muted);
  text-decoration: none;
}

.weather-footer > a:hover {
  color: #00a9c7;
}
      /* ====================
         Mobile Header
      ==================== */

      /* ====================
         Musings heading — hand-drawn scribble on hover
      ==================== */

      .writing-heading {
        position: relative;
        display: inline-block;
        width: fit-content;
        margin: 0;
        padding: 0;
        font-size: 15px;
        line-height: 1.5;
        font-weight: 400;
        color: var(--muted-text, #777);
      }

      .writing-heading-label {
        position: relative;
        z-index: 2;
        display: inline-block;
      }

      .writing-heading-scribble {
        position: absolute;
        z-index: 1;
        left: -2px;
        bottom: -5px;
        width: 95px;
        height: 16px;
        overflow: visible;
        pointer-events: none;
      }

      .writing-heading-scribble path {
        fill: none;
        stroke: #00a9c7;
        stroke-width: 1.25;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 115;
        stroke-dashoffset: 115;
        opacity: 0;
        transition:
          stroke-dashoffset 420ms cubic-bezier(.2, .8, .2, 1),
          opacity 120ms ease;
      }

      .writing:hover .writing-heading-scribble path,
      .writing:focus-within .writing-heading-scribble path {
        stroke-dashoffset: 0;
        opacity: 0.85;
      }

      /* ====================
         Writing post — ink-spill hover
      ==================== */

      .writing-post {
        position: relative;
        transition:
          transform 180ms ease,
          background-color 180ms ease;
      }

      .writing-post-title {
        position: relative;
        display: inline-block;
        color: inherit;
        text-decoration: none !important;
      }

      .writing-post-title::after {
        content: "";
        position: absolute;
        left: -2px;
        right: -3px;
        bottom: -2px;
        height: 5px;
        border-top: 1.5px solid #00a9c7;
        border-radius: 48% 52% 45% 55%;
        transform: scaleX(0) rotate(-0.5deg);
        transform-origin: left center;
        opacity: 0;
        transition:
          transform 300ms cubic-bezier(.2, .8, .2, 1),
          opacity 120ms ease;
        pointer-events: none;
      }

      .writing-post:hover {
        transform: translateX(2px);
      }

      .writing-post:hover .writing-post-title {
        color: inherit;
      }

      .writing-post:hover .writing-post-title::after {
        transform: scaleX(1) rotate(-0.5deg);
        opacity: 0.9;
      }

      .writing-post:focus-visible {
        outline: 1px solid #00a9c7;
        outline-offset: 4px;
      }

      @media (prefers-reduced-motion: reduce) {
        .writing-heading-scribble path {
          transition: none;
          stroke-dashoffset: 0;
          opacity: 0;
        }

        .writing:hover .writing-heading-scribble path,
        .writing:focus-within .writing-heading-scribble path {
          opacity: 0.85;
        }

        .writing-post,
        .writing-post-title::after {
          transition: none;
        }
      }

      /* ====================
         Recently Watched
      ==================== */

      .recent-movies {
        margin-top: 58px;
      }

      .recent-movies-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
      }

      .recent-movies-heading h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 400;
        color: var(--muted-text, #777);
      }
/* Popcorn reveal: appears when hovering anywhere over the movie section */

.recent-movies-heading h2 {
  position: relative;
  padding-left: 0;
  transition: padding-left 220ms ease;
}

.movie-popcorn {
  position: absolute;
  left: 0;
  bottom: -2px;
  display: inline-block;
  width: 24px;
  height: 25px;
  opacity: 0;
  transform: translateX(-5px) scale(0.9);
  transform-origin: 50% 100%;
  pointer-events: none;
  transition:
    opacity 180ms ease,
    transform 220ms ease;
}

.popcorn-bucket {
  position: absolute;
  left: 1px;
  bottom: 0;
  width: 22px;
  height: 19px;
  fill: #fffdf7;
  stroke: #e53935;
  stroke-width: 1.15;
  stroke-linecap: round;
  stroke-linejoin: round;
  transform-origin: 50% 100%;
}

.popcorn-kernel {
  position: absolute;
  width: 5px;
  height: 5px;
  background: #ffd45a;
  border: 1px solid #e0a900;
  border-radius: 55% 45% 48% 52%;
  opacity: 0;
}

.popcorn-kernel-1 {
  left: 3px;
  top: 1px;
}

.popcorn-kernel-2 {
  left: 9px;
  top: -3px;
}

.popcorn-kernel-3 {
  left: 15px;
  top: 1px;
}

/* The whole movie section controls the effect */
.recent-movies:hover .recent-movies-heading h2,
.recent-movies:focus-within .recent-movies-heading h2 {
  padding-left: 31px;
}

.recent-movies:hover .movie-popcorn,
.recent-movies:focus-within .movie-popcorn {
  opacity: 1;
  transform: translateX(0) scale(0.9);
}

.recent-movies:hover .popcorn-bucket,
.recent-movies:focus-within .popcorn-bucket {
  animation: popcorn-bucket-wobble 1.15s ease-in-out infinite;
}

.recent-movies:hover .popcorn-kernel,
.recent-movies:focus-within .popcorn-kernel {
  animation: popcorn-pop 1.15s cubic-bezier(.2, .9, .25, 1) infinite;
}

.recent-movies:hover .popcorn-kernel-2,
.recent-movies:focus-within .popcorn-kernel-2 {
  animation-delay: 180ms;
}

.recent-movies:hover .popcorn-kernel-3,
.recent-movies:focus-within .popcorn-kernel-3 {
  animation-delay: 330ms;
}

@keyframes popcorn-bucket-wobble {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-3deg); }
  55% { transform: rotate(3deg); }
  75% { transform: rotate(-1.5deg); }
}

@keyframes popcorn-pop {
  0%, 8% {
    opacity: 0;
    transform: translateY(4px) scale(0.45) rotate(-10deg);
  }

  25% {
    opacity: 1;
    transform: translateY(-1px) scale(0.9) rotate(7deg);
  }

  58% {
    opacity: 0.95;
    transform: translateY(-9px) scale(1) rotate(-7deg);
  }

  100% {
    opacity: 0;
    transform: translateY(-12px) scale(0.65) rotate(12deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .movie-popcorn {
    transition: none;
  }

  .recent-movies:hover .popcorn-bucket,
  .recent-movies:hover .popcorn-kernel,
  .recent-movies:focus-within .popcorn-bucket,
  .recent-movies:focus-within .popcorn-kernel {
    animation: none;
  }

  .recent-movies:hover .movie-popcorn,
  .recent-movies:focus-within .movie-popcorn {
    opacity: 1;
    transform: scale(0.9);
  }
}

      .recent-movies-heading a {
        font-size: 12px;
        color: var(--muted-text, #999);
        text-decoration: none;
        white-space: nowrap;
        transition: color 160ms ease;
      }

      .recent-movies-heading a:hover {
        color: #00a9c7;
      }

      .movie-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
      }

      .movie-card {
        min-width: 0;
        color: inherit;
        text-decoration: none;
      }

