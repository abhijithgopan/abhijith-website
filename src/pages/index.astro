    </main>


    <script is:inline>

      const themeButton =
        document.querySelector(".theme-toggle");


      function updateThemeButton() {

        const isDark =
          document.documentElement.dataset.theme === "dark";


        themeButton.setAttribute(
          "aria-label",
          isDark
            ? "Switch to light mode"
            : "Switch to dark mode"
        );


        themeButton.setAttribute(
          "title",
          isDark
            ? "Switch to light mode"
            : "Switch to dark mode"
        );

      }


      themeButton.addEventListener("click", () => {

        const isDark =
          document.documentElement.dataset.theme === "dark";


        const newTheme =
          isDark
            ? "light"
            : "dark";


        document.documentElement.dataset.theme =
          newTheme;


        localStorage.setItem(
          "theme",
          newTheme
        );


        updateThemeButton();

      });


      updateThemeButton();


      /* ====================
         Weather Helpers
      ==================== */

      function formatTime(localTime) {

        if (
          typeof localTime !== "string"
        ) {
          return "";
        }


        const timePart =
          localTime.split("T")[1];


        if (!timePart) {
          return "";
        }


        const [hour, minute] =
          timePart.split(":");


        const hourNumber =
          Number(hour);


        if (!Number.isFinite(hourNumber)) {
          return "";
        }


        const formattedHour =
          hourNumber % 12 || 12;


        const period =
          hourNumber >= 12
            ? "PM"
            : "AM";


        return `${formattedHour}:${minute} ${period}`;

      }


      function getWeatherScene(code) {

        if (typeof code !== "number") {
          return "cloudy";
        }


        if (code === 0) {
          return "clear";
        }


        if (
          [1, 2, 3].includes(code)
        ) {
          return "cloudy";
        }


        if (
          [45, 48].includes(code)
        ) {
          return "fog";
        }


        if (
          [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(code)
        ) {
          return "rain";
        }


        if (
          [71, 73, 75, 77, 85, 86].includes(code)
        ) {
          return "snow";
        }


        if (
          [95, 96, 99].includes(code)
        ) {
          return "storm";
        }


        return "cloudy";

      }


      /* ====================
         Visitor / Weather Data
      ==================== */

      const myWeather =
        document.querySelector("#my-weather");


      const visitorDistance =
        document.querySelector("#visitor-distance");


      const weatherScene =
        document.querySelector("#weather-scene");


      async function loadVisitorInformation() {

        try {

          const response =
            await fetch("/api/visitor", {
              cache: "no-store"
            });


          if (!response.ok) {
            return;
          }


          const data =
            await response.json();


          if (
            !data.available
          ) {
            return;
          }


          /* ====================
             My Delhi Weather
          ==================== */

          const myData =
            data.me;


          if (myData) {

            const myTemperature =
              myData.weather?.temperature;


            const myDescription =
              myData.weather?.description;


            const myTime =
              formatTime(
                myData.localTime
              );


            const myParts = [];


            if (myTime) {

              myParts.push(
                myTime
              );

            }


            if (
              typeof myTemperature === "number"
            ) {

              myParts.push(
                `${Math.round(myTemperature)}°C`
              );

            }


            if (myDescription) {

              myParts.push(
                myDescription
              );

            }


            if (myParts.length) {

              myWeather.textContent =
                myParts.join(" · ");

            }


            const weatherCode =
              myData.weather?.code;


            weatherScene.dataset.weather =
              getWeatherScene(
                weatherCode
              );

          }


          /* ====================
             Distance From Visitor
          ==================== */

          const visitorData =
            data.visitor;


          const distance =
            visitorData?.distance?.kilometers;


          if (
            typeof distance === "number"
          ) {

            visitorDistance.textContent =
              `You're ~${distance.toLocaleString("en-IN")} km away from me.`;


            visitorDistance.classList.remove(
              "hidden"
            );


            visitorDistance.classList.add(
              "visible"
            );

          }

        } catch (error) {

          console.error(
            "Unable to load visitor information:",
            error
          );

        }

      }


      loadVisitorInformation();

    </script>


  </body>
</html>