---
interface LineDatum {
  label: string;
  value: number;
}

interface Props {
  data: LineDatum[];
  max?: number;
  min?: number;
  title?: string;
  subtitle?: string;
  tag?: string;
  suffix?: string;
  decimals?: number;
  xLabel?: string;
  ariaLabel?: string;
  caption?: string;
}

const {
  data,
  max = Math.max(...data.map((item) => item.value), 1),
  min = 0,
  title,
  subtitle,
  tag,
  suffix = "",
  decimals = 1,
  xLabel,
  ariaLabel = "Line chart",
  caption,
} = Astro.props;

const left = 58;
const top = 24;
const width = 622;
const height = 292;
const range = max - min || 1;
const pointX = (index: number) => data.length === 1 ? left + width / 2 : left + (index / (data.length - 1)) * width;
const pointY = (value: number) => top + height - ((value - min) / range) * height;
const points = data.map((item, index) => `${pointX(index)},${pointY(item.value)}`).join(" ");
const formatValue = (value: number) => `${value.toFixed(decimals)}${suffix}`;
---

<figure class="chart-surface chart-line">
  {(title || subtitle || tag) && (
    <header class="chart-heading">
      <div>
        {title && <div class="chart-title">{title}</div>}
        {subtitle && <div class="chart-subtitle">{subtitle}</div>}
      </div>
      {tag && <span class="chart-tag">{tag}</span>}
    </header>
  )}

  <div class="line-container">
    <svg viewBox="0 0 720 370" role="img" aria-label={ariaLabel}>
      <g class="grid" aria-hidden="true">
        {Array.from({ length: 6 }, (_, i) => {
          const yy = top + (i / 5) * height;
          return <line x1={left} y1={yy} x2={left + width} y2={yy} />;
        })}
      </g>

      <polyline points={points} class="line" />

      {data.map((item, index) => (
        <circle
          cx={pointX(index)}
          cy={pointY(item.value)}
          r="4.5"
          data-label={item.label}
          data-value={formatValue(item.value)}
          tabindex="0"
          role="img"
          aria-label={`${item.label}: ${formatValue(item.value)}`}
        />
      ))}

      {data.map((item, index) => (
        <text class="x-tick" x={pointX(index)} y="340">{item.label}</text>
      ))}
    </svg>
    <div class="line-tip" hidden></div>
  </div>

  {xLabel && <div class="axis-title">{xLabel}</div>}
  {caption && <figcaption class="chart-caption">{caption}</figcaption>}
</figure>

<style>
  .line-container { position: relative; overflow-x: auto; }
  svg { display: block; width: 100%; min-width: 600px; height: auto; }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .line { fill: none; stroke: var(--chart-neutral); stroke-width: 2; vector-effect: non-scaling-stroke; }
  circle { fill: var(--chart-neutral); stroke: var(--background); stroke-width: 2; cursor: pointer; transition: fill 140ms ease, r 140ms ease; }
  circle:hover, circle:focus { fill: var(--chart-accent); r: 6; outline: none; }
  circle:focus-visible { stroke: var(--chart-accent); }
  .x-tick { fill: var(--muted); font-size: 10px; text-anchor: middle; }
  .axis-title { margin-top: 5px; color: var(--muted); font-size: 10px; text-align: center; }
  .line-tip {
    position: fixed;
    z-index: 50;
    padding: 7px 9px;
    border: 1px solid var(--chart-tooltip-border);
    border-radius: 5px;
    background: var(--chart-tooltip-bg);
    color: var(--chart-tooltip-text);
    font-size: 11px;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { circle { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".chart-line").forEach((chart) => {
    const tip = chart.querySelector<HTMLElement>(".line-tip");
    if (!tip) return;
    chart.querySelectorAll<SVGCircleElement>("circle").forEach((point) => {
      const show = () => {
        tip.hidden = false;
        tip.textContent = `${point.dataset.label}: ${point.dataset.value}`;
        const rect = point.getBoundingClientRect();
        tip.style.left = `${Math.min(window.innerWidth - 190, Math.max(10, rect.left + rect.width / 2 - 55))}px`;
        tip.style.top = `${Math.max(10, rect.top - 38)}px`;
      };
      const hide = () => { tip.hidden = true; };
      point.addEventListener("mouseenter", show);
      point.addEventListener("mouseleave", hide);
      point.addEventListener("focus", show);
      point.addEventListener("blur", hide);
    });
  });
</script>
