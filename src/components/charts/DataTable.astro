---
interface Column {
  key: string;
  label: string;
}

interface Props {
  columns: Column[];
  rows: Record<string, string | number>[];
  ariaLabel?: string;
}

const { columns, rows, ariaLabel = "Data table" } = Astro.props;
---

<div class="chart-table-wrap">
  <table aria-label={ariaLabel}>
    <thead>
      <tr>
        {columns.map((column) => <th scope="col">{column.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {columns.map((column, index) => (
            <td class:list={{ numeric: index > 0 }}>{row[column.key]}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .chart-table-wrap {
    margin: 28px 0 36px;
    overflow-x: auto;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.5;
  }

  th,
  td {
    padding: 11px 9px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }

  th {
    color: var(--muted);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  tbody tr:last-child td { border-bottom: 0; }
  td.numeric { font-variant-numeric: tabular-nums; }
</style>
