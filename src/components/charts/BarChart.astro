---
interface BarDatum {
  label: string;
  value: number;
}

interface Props {
  data: BarDatum[];
  max?: number;
  title?: string;
  subtitle?: string;
  tag?: string;
  suffix?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  data,
  max = Math.max(...data.map((item) => item.value), 100),
  title,
  subtitle,
  tag,
  suffix = "%",
  ariaLabel = "Bar chart",
  class: className = "",
} = Astro.props;

const safeMax = max > 0 ? max : 1;
---

<div class={`chart-surface chart-bar ${className}`.trim()}>
  {(title || subtitle || tag) && (
    <div class="chart-heading">
      <div>
        {title && <div class="chart-title">{title}</div>}
        {subtitle && <div class="chart-subtitle">{subtitle}</div>}
      </div>
      {tag && <span class="chart-tag">{tag}</span>}
    </div>
  )}

  <div class="bar-list" role="img" aria-label={ariaLabel}>
    {data.map((item) => (
      <div class="bar-row" tabindex="0" data-label={item.label} data-value={item.value}>
        <span class="bar-label">{item.label}</span>
        <div class="bar-track" aria-hidden="true">
          <i class="bar-fill" style={`--value:${Math.min(100, Math.max(0, (item.value / safeMax) * 100))}%`}></i>
        </div>
        <strong>{item.value}{suffix}</strong>
      </div>
    ))}
  </div>
</div>

<style>
  .bar-list {
    display: grid;
    gap: 13px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 125px minmax(0, 1fr) 52px;
    align-items: center;
    gap: 11px;
    padding: 3px 4px;
    margin: 0 -4px;
    border-radius: 4px;
    transition: background-color 140ms ease;
  }

  .bar-label {
    font-size: 11px;
  }

  .bar-track {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--chart-track);
  }

  .bar-fill {
    display: block;
    width: var(--value);
    height: 100%;
    border-radius: inherit;
    background: var(--chart-neutral);
    transform-origin: left center;
    animation: chart-grow-bar 700ms cubic-bezier(.2,.8,.2,1) both;
    transition: background-color 140ms ease, transform 140ms ease;
  }

  .bar-row:hover,
  .bar-row:focus,
  .bar-row.is-active {
    background: color-mix(in srgb, var(--border) 35%, transparent);
    outline: none;
  }

  .bar-row:hover .bar-fill,
  .bar-row:focus .bar-fill,
  .bar-row.is-active .bar-fill {
    background: var(--chart-accent);
    transform: scaleY(1.35);
  }

  .bar-row strong {
    text-align: right;
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  @keyframes chart-grow-bar {
    from { transform: scaleX(0); opacity: .3; }
    to { transform: scaleX(1); opacity: 1; }
  }

  @media (max-width: 600px) {
    .bar-row {
      grid-template-columns: 105px minmax(0, 1fr) 46px;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill { animation: none; transition: none; }
    .bar-row { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".chart-bar .bar-row").forEach((row) => {
    row.addEventListener("mouseenter", () => row.classList.add("is-active"));
    row.addEventListener("mouseleave", () => row.classList.remove("is-active"));
    row.addEventListener("focus", () => row.classList.add("is-active"));
    row.addEventListener("blur", () => row.classList.remove("is-active"));
  });

  const bars = document.querySelectorAll<HTMLElement>(".chart-bar .bar-fill");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.animationPlayState = "running";
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    bars.forEach((bar) => {
      bar.style.animationPlayState = "paused";
      observer.observe(bar);
    });
  }
</script>
