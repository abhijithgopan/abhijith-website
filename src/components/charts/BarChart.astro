---
interface BarDatum {
  label: string;
  value: number;
}

interface Props {
  data: BarDatum[];
  max?: number;
  title?: string;
  subtitle?: string;
  tag?: string;
  suffix?: string;
  decimals?: number;
  ariaLabel?: string;
  caption?: string;
  class?: string;
}

const {
  data,
  max = Math.max(...data.map((item) => item.value), 100),
  title,
  subtitle,
  tag,
  suffix = "%",
  decimals = 1,
  ariaLabel = "Bar chart",
  caption,
  class: className = "",
} = Astro.props;

const safeMax = max > 0 ? max : 1;
const formatValue = (value: number) => `${value.toFixed(decimals)}${suffix}`;
---

<figure class={`chart-surface chart-bar ${className}`.trim()}>
  {(title || subtitle || tag) && (
    <header class="chart-heading">
      <div>
        {title && <div class="chart-title">{title}</div>}
        {subtitle && <div class="chart-subtitle">{subtitle}</div>}
      </div>
      {tag && <span class="chart-tag">{tag}</span>}
    </header>
  )}

  <div class="bar-list" role="list" aria-label={ariaLabel}>
    {data.map((item) => (
      <div
        class="bar-row"
        tabindex="0"
        role="listitem"
        data-label={item.label}
        data-value={formatValue(item.value)}
        aria-label={`${item.label}: ${formatValue(item.value)}`}
      >
        <span class="bar-label">{item.label}</span>
        <div class="bar-track" aria-hidden="true">
          <i class="bar-fill" style={`--value:${Math.min(100, Math.max(0, (item.value / safeMax) * 100))}%`}></i>
        </div>
        <strong>{formatValue(item.value)}</strong>
      </div>
    ))}
  </div>

  {caption && <figcaption class="chart-caption">{caption}</figcaption>}
  <div class="chart-tooltip" hidden></div>
</figure>

<style>
  .bar-list { display: grid; gap: 13px; }

  .bar-row {
    display: grid;
    grid-template-columns: 125px minmax(0, 1fr) 58px;
    align-items: center;
    gap: 11px;
    padding: 4px;
    margin: 0 -4px;
    border-radius: 4px;
    cursor: default;
    transition: background-color 140ms ease;
  }

  .bar-label { font-size: 11px; }

  .bar-track {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--chart-track);
  }

  .bar-fill {
    display: block;
    width: var(--value);
    height: 100%;
    border-radius: inherit;
    background: var(--chart-neutral);
    transform: scaleX(0);
    transform-origin: left center;
    animation: chart-grow-bar 700ms cubic-bezier(.2,.8,.2,1) both;
    transition: background-color 140ms ease, transform 140ms ease;
  }

  .bar-row:hover,
  .bar-row:focus-visible,
  .bar-row.is-active {
    background: color-mix(in srgb, var(--border) 35%, transparent);
    outline: none;
  }

  .bar-row:hover .bar-fill,
  .bar-row:focus-visible .bar-fill,
  .bar-row.is-active .bar-fill {
    background: var(--chart-accent);
    transform: scaleY(1.35);
  }

  .bar-row strong {
    text-align: right;
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .chart-tooltip {
    position: fixed;
    z-index: 50;
    max-width: 220px;
    padding: 7px 9px;
    border: 1px solid var(--chart-tooltip-border);
    border-radius: 5px;
    background: var(--chart-tooltip-bg);
    color: var(--chart-tooltip-text);
    font-size: 11px;
    line-height: 1.4;
    pointer-events: none;
  }

  @keyframes chart-grow-bar {
    from { transform: scaleX(0); opacity: .35; }
    to { transform: scaleX(1); opacity: 1; }
  }

  @media (max-width: 600px) {
    .bar-row { grid-template-columns: 105px minmax(0, 1fr) 52px; gap: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill, .bar-row { animation: none; transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".chart-bar").forEach((chart) => {
    const tooltip = chart.querySelector<HTMLElement>(".chart-tooltip");
    chart.querySelectorAll<HTMLElement>(".bar-row").forEach((row) => {
      const activate = () => row.classList.add("is-active");
      const deactivate = () => row.classList.remove("is-active");
      const showTip = () => {
        activate();
        if (!tooltip) return;
        tooltip.hidden = false;
        tooltip.textContent = `${row.dataset.label}: ${row.dataset.value}`;
        const rect = row.getBoundingClientRect();
        tooltip.style.left = `${Math.min(window.innerWidth - 230, Math.max(10, rect.right - 160))}px`;
        tooltip.style.top = `${Math.max(10, rect.top - 38)}px`;
      };
      const hideTip = () => {
        deactivate();
        if (tooltip) tooltip.hidden = true;
      };
      row.addEventListener("mouseenter", showTip);
      row.addEventListener("mouseleave", hideTip);
      row.addEventListener("focus", showTip);
      row.addEventListener("blur", hideTip);
    });
  });

  const bars = document.querySelectorAll<HTMLElement>(".chart-bar .bar-fill");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.animationPlayState = "running";
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    bars.forEach((bar) => {
      bar.style.animationPlayState = "paused";
      observer.observe(bar);
    });
  }
</script>
